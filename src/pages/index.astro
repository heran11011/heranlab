---
import AccountCards from '../components/AccountCards.astro';
import HomeEntry from '../components/home/HomeEntry.astro';
import VideoShelf from '../components/home/VideoShelf.astro';
import DeskIntro from '../components/home/DeskIntro.astro';
import ChapterTabs from '../components/home/ChapterTabs.astro';
import { profile } from '../data/profile';
import { library } from '../data/library';
import Base from '../layouts/Base.astro';
import { homeCover, homeTopics } from '../lib/home';
import { getWorks } from '../lib/work';

// 编辑选读，不声称按时间排序。标题、简介、图片、发布日期均来自内容库。
const readingIds = ['dawdex-adventurex', 'wechat-rpa-ai-archive', 'wechat-gr3-companion', 'meme-art-origin', 'ai-phone-credit', 'ai-writing-on-x'];
const reading = readingIds.flatMap((id) => {
	const item = library.find((entry) => entry.id === id && entry.format !== 'video');
	return item ? [item] : [];
});
const variants = ['lead', 'support', 'support', 'gallery', 'snippet', 'snippet'] as const;
// 已核验封面的视频优先；同组保留内容库顺序，不伪装成时间排序。
const videos = library.filter((item) => item.format === 'video')
	.sort((a, b) => Number(!!homeCover(b)) - Number(!!homeCover(a)));
// 已有完整说明的工具，缩成路径便签；不把待补大图带到首页。
const works = (await getWorks()).filter((work) => !work.data.bodyTodo).slice(0, 2);
const description = 'AI 使用笔记、日常观察，和自己做的东西';
---

<Base description={description}>
	<div class="home-page" data-scrapbook="aligned">
		<DeskIntro />
		<ChapterTabs />

		<section class="reading-room" id="writing" aria-labelledby="reading-title" data-home-reading>
			<header class="reading-heading">
				<div><h2 id="reading-title"><span class="chapter-number" aria-hidden="true">01</span> 图文随记</h2></div>
				<a href="/content/">翻整本剪报册 <span class="content-total">{library.length}</span> <span aria-hidden="true">↗</span></a>
			</header>
			<div class="reading-tools" hidden>
				<div class="topic-buttons" role="group" aria-label="筛选图文与短句主题">
					{homeTopics.map((topic) => <button type="button" data-home-topic={topic} aria-pressed={topic === '全部' ? 'true' : 'false'} aria-controls="home-reading-grid">{topic}</button>)}
				</div>
				<details class="reading-order">
					<summary>版面 <span aria-hidden="true">⌄</span></summary>
					<div role="group" aria-label="封面摆放方式"><button type="button" data-scrapbook-order="aligned" aria-pressed="true">排整齐</button><button type="button" data-scrapbook-order="scattered" aria-pressed="false">散着贴</button></div>
				</details>
			</div>
			<p class="reading-count" aria-live="polite" aria-atomic="true">选读 {reading.length} 篇图文与短句</p>
			<div class="reading-grid" id="home-reading-grid">
				{reading.map((item, index) => <HomeEntry item={item} variant={variants[index]} />)}
			</div>
			<noscript><p class="no-script-note">图文与短句已全部展开，视频在下面的放映架。</p></noscript>
		</section>

		<VideoShelf items={videos} />

		<section class="work-notes" id="making" aria-labelledby="work-notes-title">
			<header class="section-heading"><div><p class="section-kicker">笔记之外，也动手做</p><h2 id="work-notes-title"><span class="chapter-number" aria-hidden="true">03</span> 做的小工具</h2></div><a href="/work/">所有作品 →</a></header>
			<div class="project-paths">
				{works.map((work) => {
					const technique = work.data.meta.find((meta) => ['技术', '形式'].includes(meta.k));
					return <a class="project-path" href={`/work/${work.id}/`}>
						<span class="project-route">/work/{work.id}/ <span aria-hidden="true">↗</span></span>
						<h3>{work.data.title}</h3>
						<p>{work.data.summary.split('。')[0]}。</p>
						{technique && <small>{technique.v}</small>}
					</a>;
				})}
			</div>
		</section>

		<section class="last-page" id="contact" aria-labelledby="last-page-title">
			<div class="closing-note"><p class="section-kicker">04 / 页末 · 找到我</p><h2 id="last-page-title">内容散落，<br />在这里放好。</h2><p>从 AI 的一次实测，到一个不顺手的界面，再到自己做的小工具。公众号文章、笔记、短句和视频，在这里一起翻。</p><a href="/about/">再认识一下禾冉 →</a></div>
			<div class="closing-links"><AccountCards /><div class="contact-line"><span>有想聊的？写封邮件。</span><a href={`mailto:${profile.email}`}>{profile.email}</a><button class="copy" type="button" data-copy={profile.email}>复制邮箱</button></div></div>
		</section>
	</div>
</Base>

<script>
	document.querySelectorAll<HTMLElement>('[data-home-reading]').forEach((room) => {
		const tools = room.querySelector<HTMLElement>('.reading-tools');
		const grid = room.querySelector<HTMLElement>('.reading-grid');
		const count = room.querySelector<HTMLElement>('.reading-count');
		const buttons = Array.from(room.querySelectorAll<HTMLButtonElement>('[data-home-topic]'));
		const entries = Array.from(room.querySelectorAll<HTMLElement>('[data-home-entry]'));
		const page = room.closest<HTMLElement>('.home-page');
		const orders = Array.from(room.querySelectorAll<HTMLButtonElement>('[data-scrapbook-order]'));
		const orderMenu = room.querySelector<HTMLDetailsElement>('.reading-order');
		if (!tools || !grid || !count || !page) return;
		const arrange = (order: string) => {
			page.dataset.scrapbook = order === 'scattered' ? 'scattered' : 'aligned';
			orders.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.scrapbookOrder === page.dataset.scrapbook)));
		};
		// 新版默认端正；旧版曾自动写入的“散贴”状态不带入本轮。
		try { arrange(localStorage.getItem('heran-scrapbook-order-v2') || 'aligned'); } catch {}
		orders.forEach((button) => button.addEventListener('click', () => {
			arrange(button.dataset.scrapbookOrder || 'scattered');
			try { localStorage.setItem('heran-scrapbook-order-v2', page.dataset.scrapbook!); } catch {}
			if (orderMenu) {
				orderMenu.open = false;
				orderMenu.querySelector<HTMLElement>('summary')?.focus({ preventScroll: true });
			}
		}));
		document.addEventListener('pointerdown', (event) => {
			if (orderMenu && event.target instanceof Node && !orderMenu.contains(event.target)) orderMenu.open = false;
		});
		orderMenu?.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') {
				orderMenu.open = false;
				orderMenu.querySelector<HTMLElement>('summary')?.focus({ preventScroll: true });
			}
		});
		buttons.forEach((button) => button.addEventListener('click', () => {
			const topic = button.dataset.homeTopic;
			buttons.forEach((entry) => entry.setAttribute('aria-pressed', String(entry === button)));
			entries.forEach((entry) => { entry.hidden = topic !== '全部' && entry.dataset.topic !== topic; });
			grid.dataset.filtered = String(topic !== '全部');
			count.textContent = `${topic === '全部' ? '选读' : topic} ${entries.filter((entry) => !entry.hidden).length} 篇图文与短句`;
		}));
		tools.hidden = false;
	});
</script>

<style>
	.home-page { padding-bottom: 28px; --home-ease: var(--decel); }
	.home-page :is(section[id]) { scroll-margin-top: 126px; }
	.chapter-number { display: inline-block; margin-right: 14px; font: 400 24px/1 var(--serif-en); color: var(--ink-3); }
	.reading-room { padding-top: 28px; }
	.content-total { margin-inline: 7px; color: var(--ink-2); font: 14px var(--mono); }
	.reading-order { position: relative; z-index: 2; flex: none; }
	.reading-order summary { display: flex; align-items: center; gap: 7px; min-height: 44px; min-width: 44px; color: var(--ink-2); font: 12px var(--sans); cursor: pointer; list-style: none; }
	.reading-order summary::-webkit-details-marker { display: none; }
	.reading-order > div { position: absolute; top: 100%; right: 0; display: flex; width: 170px; padding: 7px; background: var(--paper-2); border: 1px solid var(--rule); box-shadow: var(--shadow-paper); }
	.reading-order button { min-height: 44px; padding: 0 10px; cursor: pointer; border: 0; border-bottom: 1px solid transparent; background: transparent; color: var(--ink-2); font: 11px var(--sans); }
	.reading-order button[aria-pressed='true'] { color: var(--accent); border-bottom-color: var(--accent); }
	.reading-order button:hover { color: var(--ink); }
	.reading-heading, .section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 18px; }
	h2 { font: 400 30px/1.3 var(--serif-zh); margin: 0; }
	.reading-heading h2 { font-size: 28px; }
	.reading-heading > a, .section-heading > a { font-size: 12px; color: var(--ink-2); text-decoration: none; }
	.reading-tools { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 7px 14px; margin: 14px 0 21px; }
	.reading-tools[hidden] { display: none; }
	.topic-buttons { display: flex; gap: 6px; flex-wrap: wrap; }
	.topic-buttons button { font: 12px var(--sans); cursor: pointer; min-height: 44px; padding: 0 14px; border: 0; border-bottom: 1px solid transparent; border-radius: 0; background: transparent; color: var(--ink-2); transition: background var(--motion-fast) var(--home-ease), color var(--motion-fast) var(--home-ease); }
	.topic-buttons button[aria-pressed='true'] { color: var(--accent); border-bottom-color: var(--accent); }
	.topic-buttons button:hover:not([aria-pressed='true']) { background: var(--paper-3); color: var(--ink); }
	/* 数量继续向辅助技术播报，画面上不再增加一层重复说明。 */
	.reading-count { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; margin: 0; }
	.reading-grid { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 28px 56px; margin-top: 14px; align-items: start; }
	.reading-grid[data-filtered='true'] { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	.reading-grid[data-filtered='true'] > :global(.entry) { grid-column: auto; grid-row: auto; }
	.reading-grid[data-filtered='true'] > :global(.entry--lead) { grid-column: 1 / -1; max-width: 760px; }
	.no-script-note { font-size: 12px; color: var(--ink-2); }
	.work-notes { padding: 40px 0 48px; }
	.section-kicker { font-size: 12px; color: var(--accent); margin: 0 0 7px; }
	.project-paths { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; margin-top: 24px; }
	.project-path { display: block; padding: 22px 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); text-decoration: none; transition: transform 350ms var(--spring), border-color 180ms var(--home-ease); }
	.project-route { font: 11px/1.5 var(--mono); color: var(--accent); display: flex; justify-content: space-between; gap: 12px; }
	.project-path h3 { font: 400 24px/1.4 var(--serif-zh); margin: 12px 0 8px; }
	.project-path p { font-size: 14px; color: var(--ink-2); margin: 0 0 12px; }
	.project-path small { font: 11px/1.6 var(--mono); color: var(--ink-2); }
	.project-path:hover { border-color: var(--accent); }
	@media (hover: hover) and (pointer: fine) { .project-path:hover { transform: translateY(-4px); } }
	.project-path:hover h3 { color: var(--accent); }
	.last-page { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); gap: 64px; padding: 40px 0 52px; border-top: 1px solid var(--rule); }
	.closing-note h2 { font-size: 32px; line-height: 1.4; }
	.closing-note > p:not(.section-kicker) { max-width: 29em; font-size: 14px; color: var(--ink-2); margin: 18px 0; }
	.closing-note > a { font-size: 13px; color: var(--accent); text-decoration: none; display: inline-flex; min-height: 44px; align-items: center; }
	.closing-links { min-width: 0; padding-top: 4px; }
	.contact-line { display: flex; align-items: center; gap: 10px 16px; flex-wrap: wrap; padding-top: 24px; margin-top: 24px; border-top: 1px dashed var(--rule); }
	.contact-line > span { width: 100%; font-size: 12px; color: var(--ink-2); }
	.contact-line > a { display: inline-flex; align-items: center; min-height: 44px; font: 14px/1.8 var(--mono); color: var(--accent); text-decoration: none; overflow-wrap: anywhere; }
	.contact-line .copy { min-height: 44px; min-width: 44px; }
	.home-page a:focus-visible, .home-page button:focus-visible, .home-page summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
	.reading-heading a:hover, .section-heading a:hover, .closing-note a:hover, .contact-line a:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 4px; }
	@media (max-width: 1000px) {
		.reading-grid { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 24px; }
		.last-page { gap: 32px; }
	}
	@media (max-width: 700px) {
		.reading-tools { gap: 7px; }
		.reading-order { margin-left: auto; }
		.reading-heading { align-items: flex-end; }
		.reading-heading > a { max-width: 105px; text-align: right; line-height: 1.8; }
		.reading-heading h2 { font-size: 26px; }
		.chapter-number { font-size: 22px; margin-right: 7px; }
		.topic-buttons { gap: 3px; }
		.topic-buttons button { padding: 0 8px; }
		.reading-grid, .reading-grid[data-filtered='true'] { grid-template-columns: minmax(0, 1fr); gap: 24px; }
		.reading-grid[data-filtered='true'] > :global(.entry--lead) { grid-column: auto; }
		.project-paths, .last-page { grid-template-columns: minmax(0, 1fr); gap: 18px; }
		.project-path { padding: 20px 0; }
		.last-page { padding: 32px 0; gap: 24px; }
		.closing-note h2 br { display: none; }
		.closing-note h2 { font-size: 28px; }
		.work-notes { padding: 32px 0; }
	}
	@media (prefers-reduced-motion: reduce) { .topic-buttons button, .project-path { transition: none; } .project-path:hover { transform: none; } }
</style>
