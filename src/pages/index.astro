---
import Todo from '../components/Todo.astro';
import AccountCards from '../components/AccountCards.astro';
import WorkCard from '../components/WorkCard.astro';
import { SITE_DESCRIPTION } from '../consts';
import { profile } from '../data/profile';
import { library, platformLabels } from '../data/library';
import Base from '../layouts/Base.astro';
import { getWorks } from '../lib/work';

const works = await getWorks();
const featured = works.filter((w) => w.data.featured).slice(0, 3);
const selectedContent = library.filter((item) => item.featured).slice(0, 3);
const h = profile.headline;
---

<Base description={SITE_DESCRIPTION}>
	<section class="hero">
		<aside class="note rise d1">
			<span class="mono">NO.00 · 自我介绍</span>
			<h1>
				{h.before}{h.br && <br />}{h.mid}<span class="hl">{h.hl}</span>{h.after}{h.todo && <Todo label={h.todo} where="首页 · 首屏那句话" />}
			</h1>
			<dl class="facts">
				{profile.facts.map((f) => <div><dt>{f.k}</dt><dd>{f.v}</dd></div>)}
			</dl>
			<div class="btns">
				<a class="btn solid" href="/work/">看作品 →</a>
				<a class="btn" href="#contact">联系我</a>
			</div>
		</aside>

		<div>
			<div class="sec-head rise d2">
				<h2>精选作品</h2>
				<a href="/work/">全部作品 →</a>
			</div>
			<div class="works">
				{featured.map((w, i) => <WorkCard work={w} index={i + 1} wide={w.data.wide} class={`rise d${Math.min(i + 2, 4)}`} />)}
			</div>
		</div>
	</section>

	<section class="row">
		<header>
			<h2>作品进展</h2>
			<span class="mono">做过的 · 在做的</span>
		</header>
		<ol class="timeline">
			{
				profile.timeline.map((t) => (
					<li>
						<span class="mono">{t.when}</span>
						<div>
							<h3>{'href' in t && t.href ? <a href={t.href}>{t.title}</a> : t.title}</h3>
							<p>{t.desc}</p>
						</div>
					</li>
				))
			}
		</ol>
	</section>

	<section class="row" id="writing">
		<header>
			<h2>写的东西</h2>
			<span class="mono">笔记 · 观察 · 视频</span>
			<p class="content-intro">散落在各个平台的内容，<br />也在这里慢慢整理。</p>
			<a class="btn" href="/content/">去看全部内容 →</a>
		</header>
		<div>
			<ol class="home-content">
				{selectedContent.map((item, i) => (
					<li>
						<a href={`/content/${item.id}/`}>
							<span class="mono">0{i + 1} / {platformLabels[item.platform]} · {item.topic}</span>
							<h3>{item.title}</h3>
							<p>{item.excerpt}</p>
							<span class="read">在这里读 →</span>
						</a>
					</li>
				))}
			</ol>
			<AccountCards />
		</div>
	</section>

	<section class="row" id="contact">
		<header>
			<h2>联系</h2>
			<span class="mono">邮件最快</span>
		</header>
		<div>
			<div class="mail">
				<a href={`mailto:${profile.email}`}>{profile.email}</a>
				<button class="copy" type="button" data-copy={profile.email}>复制</button>
			</div>
		</div>
	</section>
</Base>

<style>
	.content-intro { color: var(--ink-2); font-size: 15px; margin: 18px 0 24px; }
	.home-content { list-style: none; padding: 0; margin: 0 0 30px; }
	.home-content li + li { border-top: 1px dashed var(--rule); }
	.home-content a { display: block; padding: 22px 0; text-decoration: none; }
	.home-content li:first-child a { padding-top: 0; }
	.home-content h3 { font-family: var(--serif-zh); font-size: 24px; line-height: 1.4; font-weight: 400; margin: 7px 0; }
	.home-content p { color: var(--ink-2); font-size: 15px; margin: 0; }
	.home-content .read { display: inline-block; margin-top: 12px; color: var(--accent); font-size: 13px; }
	.home-content a:hover h3 { text-decoration: underline; text-underline-offset: 5px; }
	.home-content a:focus-visible { outline: 2px solid var(--accent); outline-offset: 6px; }
</style>
