---
import { getCollection } from 'astro:content';
import { BLOG_DESCRIPTION } from '../../consts';
import { ymd } from '../../lib/date';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Base title="文章" description={BLOG_DESCRIPTION}>
	<section class="row first">
		<header>
			<h1>文章</h1>
			<span class="mono">{posts.length} 篇 · 英文</span>
		</header>
		<ul class="posts">
			{
				posts.map((p) => (
					<li>
						<a href={`/blog/${p.id}/`} lang="en">
							<span class="mono">{ymd(p.data.pubDate)}</span>
							<h3>{p.data.title}</h3>
							<span class="pill">EN</span>
							<p>{p.data.description}</p>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</Base>
