---
import { library, libraryFormats, platformLabels } from '../../data/library';
import type { LibraryItem } from '../../data/library';
import ImageViewer from '../../components/content/ImageViewer.astro';
import ReaderPreferences from '../../components/content/ReaderPreferences.astro';
import Base from '../../layouts/Base.astro';
import { homeCover } from '../../lib/home';

export function getStaticPaths() {
	return library.map((item) => ({
		params: { slug: item.id },
		props: { item },
	}));
}

interface Props {
	item: LibraryItem;
}

const { item } = Astro.props;
const index = library.findIndex((entry) => entry.id === item.id);
const previous = library[index - 1];
const next = library[index + 1];
const number = String(index + 1).padStart(2, '0');
const platform = platformLabels[item.platform];
const format = libraryFormats[item.format];
const hasParagraphs = !!item.paragraphs?.some((paragraph) => paragraph.trim());
const bodyLabel = item.bodyLabel || (hasParagraphs ? (item.format === 'video' ? '视频简介原文' : '原文') : '内容简介');
const isShort = (item.paragraphs?.length || 0) <= 2 && (item.paragraphs?.join('').length || 0) < 320;
const isVideo = item.format === 'video';
const cover = homeCover(item);
const videoLink = item.platform === 'bilibili' ? '去 B 站播放视频' : item.platform === 'xiaohongshu' ? '去小红书看视频' : '去 X 看视频';
const sourceLinkLabel = isVideo ? videoLink : '查看原文';
---

<Base title={item.title} description={item.excerpt} type="article">
	<article class:list={['content-detail', { 'is-video': isVideo, 'is-short': isShort, 'has-image': !!item.cover }]} data-reader-article data-reader-format={item.format} data-focused="false">
		<nav class="content-back" aria-label="返回目录">
			<a href="/content/"><span aria-hidden="true">←</span> 返回内容</a>
			<span>禾冉的剪报 / heran</span>
		</nav>

		<header class="content-heading">
			<p class="content-eyebrow"><span class="content-entry-number">{number}</span><span>{format} / {item.topic}</span></p>
			<h1>{item.title}</h1>
			{!isShort && <p class="content-excerpt" data-reader-secondary>{item.excerpt}</p>}
		</header>

		<ReaderPreferences nextHref={next && `/content/${next.id}/`} nextTitle={next?.title} />

		<div class="content-reading-layout">
			{(item.cover || isVideo) && <div class="content-media">
				{item.cover ? (
					<ImageViewer src={item.cover} width={cover?.width} height={cover?.height} alt={`“${item.title}”的${isVideo ? '视频封面' : '原文配图'}`} caption={`${isVideo ? '视频封面' : '原文配图'} · ${platform}`} videoUrl={isVideo ? item.sourceUrl : undefined} videoLabel={videoLink} />
				) : (
					<a class="content-video-entry" href={item.sourceUrl} target="_blank" rel="noopener noreferrer"><span aria-hidden="true">▶</span><span>{videoLink} ↗</span><span class="sr-only">（新窗口打开）</span></a>
				)}
			</div>}

			<div class="content-main">
				<section class="content-body" aria-labelledby="content-body-label">
					<h2 id="content-body-label"><span aria-hidden="true">01 /</span> {bodyLabel}</h2>
					{isVideo && <p class="content-video-caption">这里是视频简介。</p>}
					<div class="content-paragraphs" data-reader-body>
						{hasParagraphs ? item.paragraphs?.map((paragraph) => <p>{paragraph}</p>) : <>
							<p>{item.excerpt}</p>
							<p class="content-body-unavailable">这里只收录了简介，未整理完整正文。请前往原文查看。</p>
						</>}
					</div>
				</section>

				<footer class="content-source" data-reader-source>
					<div class="content-source-link"><span>原文在这里</span><a href={item.sourceUrl} target="_blank" rel="noopener noreferrer">{sourceLinkLabel} <span aria-hidden="true">↗</span><span class="sr-only">（新窗口打开）</span></a></div>
					<details class="content-source-details">
						<summary>出处与核对记录</summary>
						<p>出处：{platform} · {item.sourceAuthor}</p>
						{item.publishedAt && <p>发布日期：<time datetime={item.publishedAt}>{item.publishedAt}</time></p>}
						<p>内容整理自本人公开发布，原文可能更新。</p>
						<p>核对日期：<time datetime={item.verifiedAt}>{item.verifiedAt}</time></p>
					</details>
				</footer>
			</div>

			<aside class="content-margin-note" aria-label="剪报小注" data-reader-secondary>
				<p class="content-note-label">页边小注 / {number}</p>
				<p class="content-note-topic">{item.topic}</p>
				{isShort && <p class="content-note-excerpt">{item.excerpt}</p>}
				<dl>
					<div><dt>出处</dt><dd>{platform} · {item.sourceAuthor}</dd></div>
					{item.publishedAt && <div><dt>发布</dt><dd><time datetime={item.publishedAt}>{item.publishedAt}</time></dd></div>}
				</dl>
				<span class="content-signature">禾冉 <i>/ heran</i></span>
			</aside>
		</div>

		<nav class="content-pagination" aria-label="继续翻阅" data-reader-pagination>
			<p><span aria-hidden="true">02 /</span> 接着翻一页</p>
			<div>
				{previous ? <a href={`/content/${previous.id}/`} rel="prev"><span>← 上一篇</span><strong>{previous.title}</strong></a> : <a href="/content/"><span>← 第一页</span><strong>回到内容目录</strong></a>}
				{next ? <a href={`/content/${next.id}/`} rel="next"><span>下一篇 →</span><strong>{next.title}</strong></a> : <a href="/content/"><span>这一册，暂时翻到这里</span><strong>回到内容目录 →</strong></a>}
			</div>
		</nav>
	</article>
</Base>

<style>
	.content-detail { padding: 28px clamp(0px, 2vw, 24px) max(64px, env(safe-area-inset-bottom)); }
	.content-detail :is(h1, h2, p, dd, a) { overflow-wrap: anywhere; }
	.content-back { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; border-bottom: 1px solid var(--reader-rule); }
	.content-back a { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; color: var(--reader-accent); font-size: 12px; text-decoration: none; }
	.content-back > span { color: var(--reader-muted); font: 11px var(--mono); }
	.content-heading { max-width: 950px; padding: 40px 0 32px; }
	.content-eyebrow { display: flex; align-items: center; gap: 20px; margin: 0 0 20px; color: var(--reader-leaf); font: 11px/1.6 var(--mono); }
	.content-entry-number { font: 52px/1 var(--serif-en); color: var(--reader-accent); }
	.content-heading h1 { max-width: 18em; margin: 0; font: 400 clamp(36px, 5.2vw, 66px)/1.2 var(--serif-zh); letter-spacing: -0.025em; text-wrap: pretty; }
	.content-excerpt { max-width: 34em; margin: 24px 0 0; color: var(--reader-muted); font: 18px/1.85 var(--serif-zh); }
	.content-reading-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(220px, 290px); grid-template-rows: max-content 1fr; column-gap: clamp(32px, 5vw, 68px); row-gap: 22px; align-items: start; }
	.content-main { grid-column: 1; grid-row: 1 / 3; min-width: 0; max-width: 798px; }
	.content-media { grid-column: 2; grid-row: 1; min-width: 0; }
	.content-margin-note { grid-column: 2; grid-row: 2; padding: 4px 0 4px 18px; border-left: 2px solid var(--reader-leaf); color: var(--reader-muted); }
	.content-detail:not(.has-image):not(.is-video) .content-margin-note { grid-row: 1; }
	.content-note-label { margin: 0 0 12px; font: 10px/1.6 var(--mono); color: var(--reader-leaf); }
	.content-note-topic { margin: 0 0 12px; font: 22px/1.5 var(--serif-zh); color: var(--reader-ink); }
	.content-note-excerpt { margin: 0 0 18px; font: 14px/1.8 var(--serif-zh); }
	.content-margin-note dl { margin: 0; font-size: 12px; line-height: 1.8; }
	.content-margin-note dl > div { margin-top: 10px; }
	.content-margin-note dt { color: var(--reader-leaf); font: 10px/1.8 var(--mono); }
	.content-margin-note dd { margin: 2px 0 0; }
	.content-signature { display: block; margin-top: 20px; color: var(--reader-ink); font: 20px var(--serif-zh); }
	.content-signature i { color: var(--reader-muted); font-family: var(--serif-en); }
	.content-body h2 { margin: 0 0 22px; font: 12px/1.8 var(--mono); color: var(--reader-muted); font-weight: 400; }
	.content-body h2 > span { margin-right: 8px; color: var(--reader-accent); }
	.content-paragraphs p { margin: 0 0 1.2em; white-space: pre-wrap; }
	.content-paragraphs > p:last-child { margin-bottom: 0; }
	.content-paragraphs .content-body-unavailable { border-left: 2px solid var(--reader-rule); padding-left: 14px; color: var(--reader-muted); font-size: 0.85em; }
	.content-video-caption { margin: 0 0 18px; color: var(--reader-muted); font-size: 13px; }
	.is-video .content-media { grid-column: 1; grid-row: 1; }
	.is-video .content-main { grid-row: 2; }
	.is-video .content-margin-note { grid-row: 1 / 3; }
	.content-video-entry { display: flex; align-items: center; gap: 18px; min-height: 100px; padding: 22px; background: var(--reader-wash); color: var(--reader-accent); font: 18px/1.5 var(--serif-zh); text-decoration: none; }
	.content-video-entry > span:first-child { font-size: 30px; }
	.content-video-entry:hover { color: var(--reader-ink); }
	.content-source { margin-top: 32px; border-top: 1px solid var(--reader-rule); padding-top: 16px; }
	.content-source-link { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px 20px; }
	.content-source-link > span { color: var(--reader-muted); font: 14px var(--serif-zh); }
	.content-source-link a { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; color: var(--reader-accent); font-size: 14px; text-decoration-thickness: 1px; text-underline-offset: 5px; }
	.content-source-details { margin-top: 4px; color: var(--reader-muted); font-size: 12px; }
	.content-source-details summary { display: list-item; width: fit-content; padding: 12px 0; min-height: 44px; box-sizing: border-box; cursor: pointer; }
	.content-source-details p { margin: 4px 0; line-height: 1.8; }
	.content-pagination { margin-top: 44px; padding-top: 20px; border-top: 1px solid var(--reader-rule); }
	.content-pagination > p { margin: 0 0 16px; color: var(--reader-muted); font: 12px var(--mono); }
	.content-pagination > p span { color: var(--reader-accent); margin-right: 8px; }
	.content-pagination > div { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
	.content-pagination a { display: block; min-height: 88px; padding: 12px 0; text-decoration: none; }
	.content-pagination a > span { display: block; color: var(--reader-accent); font: 11px/1.8 var(--mono); }
	.content-pagination strong { display: block; margin-top: 6px; font: 400 21px/1.5 var(--serif-zh); }
	.content-pagination a:hover strong { text-decoration: underline; text-underline-offset: 5px; }
	.content-detail[data-focused='true'] .content-heading { max-width: 798px; margin-inline: auto; }
	.content-detail[data-focused='true'] .content-reading-layout { display: flex; flex-direction: column; max-width: 798px; margin-inline: auto; }
	.content-detail[data-focused='true'] .content-media { width: 100%; max-width: 500px; margin-inline: auto; }
	.content-detail[data-focused='true'] .content-main { width: 100%; }
	@media (max-width: 760px) {
		.content-detail { padding: 20px 0 max(48px, env(safe-area-inset-bottom)); }
		.content-heading { padding: 28px 0 24px; }
		.content-heading h1 { font-size: clamp(32px, 6.5vw, 46px); line-height: 1.28; }
		.content-eyebrow { gap: 14px; margin-bottom: 16px; }
		.content-entry-number { font-size: 40px; }
		.content-excerpt { margin-top: 18px; font-size: 16px; }
		.content-reading-layout { display: flex; flex-direction: column; gap: 24px; }
		.content-reading-layout > * { width: 100%; }
		.content-media { order: 0; }
		.content-main { order: 1; }
		.content-margin-note { order: 2; margin-top: 4px; padding-left: 14px; }
		.content-note-topic { font-size: 18px; }
		.content-margin-note dl { display: flex; flex-wrap: wrap; gap: 8px 24px; }
		.content-signature { margin-top: 12px; }
		.content-pagination { margin-top: 32px; }
		.content-pagination > div { grid-template-columns: 1fr; gap: 0; }
		.content-pagination a + a { border-top: 1px solid var(--reader-rule); }
		.content-pagination strong { font-size: 19px; }
	}
</style>
