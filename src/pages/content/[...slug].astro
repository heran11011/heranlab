---
import { library, libraryFormats, platformLabels } from '../../data/library';
import type { LibraryItem } from '../../data/library';
import Base from '../../layouts/Base.astro';

export function getStaticPaths() {
	return library.map((item) => ({
		params: { slug: item.id },
		props: { item },
	}));
}

interface Props {
	item: LibraryItem;
}

const { item } = Astro.props;
const platform = platformLabels[item.platform];
const format = libraryFormats[item.format];
const hasParagraphs = !!item.paragraphs?.some((paragraph) => paragraph.trim());
const bodyLabel = hasParagraphs ? item.bodyLabel || (item.format === 'video' ? '视频简介原文' : '原文') : '内容简介';
const videoLink = item.platform === 'bilibili' ? '去 B 站播放视频' : item.platform === 'xiaohongshu' ? '去小红书看视频' : '去 X 看视频';
const sourceLinkLabel = item.format === 'video' ? videoLink : '查看原文';
const videoPlatform = item.platform === 'xiaohongshu' ? '小红书' : ` ${platform} `;
---

<Base title={item.title} description={item.excerpt} type="article">
	<article class="content-detail">
		<nav class="content-back" aria-label="返回目录">
			<a href="/content/"><span aria-hidden="true">←</span> 返回内容页</a>
			<span>内容剪报册 / {platform}</span>
		</nav>

		<header class="content-detail-heading">
			<p class="content-detail-category"><span>{platform}</span><span>{format}</span><span>{item.topic}</span></p>
			<h1>{item.title}</h1>
			<p class="content-detail-excerpt">{item.excerpt}</p>
			<dl class="content-detail-byline">
				<div><dt>出处</dt><dd>{platform} · {item.sourceAuthor}</dd></div>
				{item.publishedAt && <div><dt>发布日期</dt><dd><time datetime={item.publishedAt}>{item.publishedAt}</time></dd></div>}
			</dl>
		</header>

		<div class="content-reading-sheet">
			{item.cover && (
				<figure class="content-detail-cover">
					<img src={item.cover} alt={`“${item.title}”的原文配图`} decoding="async" />
					<figcaption>原文配图 · {platform}</figcaption>
				</figure>
			)}

			{item.format === 'video' && (
				<aside class="content-video-note" aria-label="视频阅读说明">
					<span class="content-video-symbol" aria-hidden="true">▷</span>
					<div>
						<p>这里收录的是视频简介，不是视频逐字稿。</p>
						<p>视频需前往{videoPlatform}播放，本页不下载或嵌入视频。</p>
						<a href={item.sourceUrl} target="_blank" rel="noopener noreferrer">{videoLink} <span aria-hidden="true">↗</span><span class="content-detail-sr">（新窗口打开）</span></a>
					</div>
				</aside>
			)}

			<section class="content-detail-body" aria-labelledby="content-body-label">
				<h2 id="content-body-label">{bodyLabel}</h2>
				{hasParagraphs ? (
					<div class="content-paragraphs">{item.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}</div>
				) : (
					<div class="content-paragraphs">
						<p>{item.excerpt}</p>
						<p class="content-body-unavailable">这里只收录了简介，未整理完整正文。请前往原文查看。</p>
					</div>
				)}
			</section>

			<footer class="content-detail-source">
				<div class="content-source-link">
					<span>回到发布的地方</span>
					<a href={item.sourceUrl} target="_blank" rel="noopener noreferrer">{sourceLinkLabel} <span aria-hidden="true">↗</span><span class="content-detail-sr">（新窗口打开）</span></a>
				</div>
				<p>内容整理自本人公开发布，原文可能更新。</p>
				<p class="content-verified">核对日期：<time datetime={item.verifiedAt}>{item.verifiedAt}</time></p>
			</footer>
		</div>
		<div class="content-detail-bottom"><a href="/content/">← 回到剪报册，继续翻阅</a></div>
	</article>
</Base>

<style>
	.content-detail { padding: 36px 0 64px; }
	.content-detail :is(h1, h2, p, dd, a) { overflow-wrap: anywhere; }
	.content-detail a:focus-visible { outline: 2px solid var(--accent); outline-offset: 5px; border-radius: 2px; }
	.content-back { display: flex; justify-content: space-between; flex-wrap: wrap; align-items: baseline; gap: 12px; padding-bottom: 20px; border-bottom: 1px solid var(--rule); }
	.content-back a { display: inline-flex; align-items: center; gap: 10px; min-height: 36px; font-size: 13px; text-decoration: none; color: var(--accent); }
	.content-back a:hover { text-decoration: underline; text-underline-offset: 4px; }
	.content-back > span { font-family: var(--mono); font-size: 11px; color: var(--ink-2); }
	.content-detail-heading { max-width: 920px; margin: 0 auto; padding: 48px 0 36px; }
	.content-detail-category { display: flex; flex-wrap: wrap; gap: 8px 12px; margin: 0 0 22px; color: var(--accent); font-family: var(--mono); font-size: 11px; }
	.content-detail-category > span + span::before { content: '/'; margin-right: 12px; color: var(--rule); }
	.content-detail-heading h1 { margin: 0; font-family: var(--serif-zh); font-weight: 400; font-size: clamp(34px, 4.7vw, 58px); line-height: 1.3; letter-spacing: -0.02em; text-wrap: pretty; }
	.content-detail-excerpt { margin: 24px 0 0; max-width: 44em; color: var(--ink-2); font-size: clamp(16px, 1.7vw, 18px); line-height: 1.9; text-wrap: pretty; }
	.content-detail-byline { display: flex; flex-wrap: wrap; gap: 12px 28px; margin: 24px 0 0; }
	.content-detail-byline > div { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px; }
	.content-detail-byline dt { font-family: var(--mono); font-size: 10px; color: var(--ink-2); }
	.content-detail-byline dd { margin: 0; color: var(--ink-2); font-size: 12px; }
	.content-reading-sheet { max-width: 740px; margin: 0 auto; padding: 32px clamp(20px, 3.5vw, 40px); border: 1px solid var(--rule); border-top: 3px solid var(--ink); border-radius: 0 0 var(--r) var(--r); background: var(--paper-2); box-shadow: 0 2px 0 -1px var(--rule); }
	.content-detail-cover { margin: 0 0 32px; }
	.content-detail-cover img { width: auto; max-width: 100%; max-height: 560px; margin: 0 auto; border: 1px solid var(--rule); border-radius: 2px; object-fit: contain; }
	.content-detail-cover figcaption { margin-top: 10px; font-family: var(--mono); font-size: 10px; color: var(--ink-2); }
	.content-video-note { display: grid; grid-template-columns: 24px minmax(0, 1fr); gap: 12px; padding: 18px; margin-bottom: 32px; border: 1px dashed var(--rule); background: var(--paper); }
	.content-video-symbol { font-size: 22px; line-height: 1.4; color: var(--accent); }
	.content-video-note p { margin: 0 0 5px; font-size: 12px; line-height: 1.85; color: var(--ink-2); }
	.content-video-note a { display: inline-flex; align-items: center; gap: 10px; min-height: 36px; margin-top: 6px; color: var(--accent); font-size: 13px; text-decoration: none; }
	.content-video-note a:hover { text-decoration: underline; text-underline-offset: 4px; }
	.content-detail-body h2 { margin: 0 0 26px; padding-bottom: 14px; border-bottom: 1px dashed var(--rule); font-family: var(--mono); font-size: 11px; font-weight: 400; letter-spacing: 0.04em; color: var(--ink-2); }
	.content-paragraphs { font-size: 17px; line-height: 1.95; }
	.content-paragraphs p { margin: 0 0 1.25em; white-space: pre-wrap; }
	.content-paragraphs > p:last-child { margin-bottom: 0; }
	.content-paragraphs .content-body-unavailable { padding-left: 14px; border-left: 2px solid var(--rule); color: var(--ink-2); font-size: 14px; }
	.content-detail-source { margin-top: 40px; padding-top: 24px; border-top: 1px solid var(--rule); }
	.content-source-link { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 20px; }
	.content-source-link > span { font-family: var(--serif-zh); font-size: 18px; }
	.content-source-link a { display: inline-flex; align-items: center; gap: 12px; min-height: 44px; padding: 8px 14px; border: 1px solid var(--accent); border-radius: 3px; color: var(--accent); font-size: 13px; text-decoration: none; transition: background 0.15s ease; }
	.content-source-link a:hover { background: var(--paper); text-decoration: underline; text-underline-offset: 4px; }
	.content-detail-source > p { margin: 0; font-size: 12px; color: var(--ink-2); }
	.content-detail-source .content-verified { margin-top: 6px; font-family: var(--mono); font-size: 10px; }
	.content-detail-bottom { max-width: 740px; margin: 28px auto 0; }
	.content-detail-bottom a { display: inline-flex; align-items: center; min-height: 44px; font-size: 13px; text-decoration: none; color: var(--accent); }
	.content-detail-bottom a:hover { text-decoration: underline; text-underline-offset: 4px; }
	.content-detail-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
	@media (max-width: 600px) {
		.content-detail { padding: 24px 0 44px; }
		.content-back > span { display: none; }
		.content-detail-heading { padding: 32px 0 28px; }
		.content-detail-heading h1 { font-size: 34px; }
		.content-detail-category { margin-bottom: 18px; }
		.content-detail-excerpt { margin-top: 18px; }
		.content-reading-sheet { padding: 24px 20px; }
		.content-paragraphs { font-size: 16px; line-height: 1.95; }
		.content-video-note { grid-template-columns: minmax(0, 1fr); gap: 8px; padding: 14px; }
		.content-video-symbol { display: none; }
		.content-source-link { align-items: start; flex-direction: column; }
	}
	@media (prefers-reduced-motion: reduce) {
		.content-source-link a { transition: none; }
	}
</style>
