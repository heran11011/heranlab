---
import { library, libraryFormats, platformLabels } from '../../data/library';
import type { LibraryItem } from '../../data/library';
import ArticleBody from '../../components/content/ArticleBody.astro';
import ImageViewer from '../../components/content/ImageViewer.astro';
import ReaderPreferences from '../../components/content/ReaderPreferences.astro';
import Base from '../../layouts/Base.astro';
import { homeCover } from '../../lib/home';

export function getStaticPaths() {
	return library.map((item) => ({
		params: { slug: item.id },
		props: { item },
	}));
}

interface Props {
	item: LibraryItem;
}

const { item } = Astro.props;
const index = library.findIndex((entry) => entry.id === item.id);
const previous = library[index - 1];
const next = library[index + 1];
const number = String(index + 1).padStart(2, '0');
const platform = platformLabels[item.platform];
const format = libraryFormats[item.format];
const hasParagraphs = !!item.paragraphs?.some((paragraph) => paragraph.trim());
const hasBlocks = !!item.blocks?.length;
const bodyLabel = item.platform === 'wechat' && item.format === 'article'
	? '公众号文章原文'
	: item.bodyLabel || (hasBlocks || hasParagraphs ? (item.format === 'video' ? '视频简介原文' : '原文') : '内容简介');
const isArticle = item.format === 'article';
const isShort = !isArticle && !hasBlocks && (item.paragraphs?.length || 0) <= 2 && (item.paragraphs?.join('').length || 0) < 320;
const isVideo = item.format === 'video';
const cover = homeCover(item);
const detailCover = item.platform === 'wechat' ? cover?.src : item.cover;
const videoLink = item.platform === 'bilibili' ? '去 B 站播放视频' : item.platform === 'xiaohongshu' ? '去小红书看视频' : '去 X 看视频';
const sourceLinkLabel = isVideo ? videoLink : '查看原文';
---

<Base title={item.title} description={item.excerpt} type="article">
	<article class:list={['content-detail', { 'is-video': isVideo, 'is-short': isShort, 'is-article': isArticle, 'has-image': !!detailCover }]} data-reader-article data-reader-format={item.format} data-focused="false">
		<nav class="content-back" aria-label="返回目录">
			<a href="/content/#content-catalog-title"><span aria-hidden="true">←</span> 返回内容</a>
			<span>禾冉的剪报 / heran</span>
		</nav>

		<header class="content-heading">
			<p class="content-eyebrow"><span class="content-entry-number">{number}</span><span>{format} / {item.topic}</span></p>
			<h1>{item.title}</h1>
			{!isShort && <p class="content-excerpt" data-reader-secondary>{item.excerpt}</p>}
		</header>

		<ReaderPreferences backHref="/content/#content-catalog-title" nextHref={next && `/content/${next.id}/`} nextTitle={next?.title} />

		<div class="content-reading-layout">
			{!isArticle && (detailCover || isVideo) && <div class="content-media">
				{detailCover ? (
					<ImageViewer src={detailCover} width={cover?.width} height={cover?.height} alt={`“${item.title}”的${isVideo ? '视频封面' : '原文配图'}`} caption={`${isVideo ? '视频封面' : '原文配图'} · ${platform}`} videoUrl={isVideo ? item.sourceUrl : undefined} videoLabel={videoLink} />
				) : (
					<a class="content-video-entry" href={item.sourceUrl} target="_blank" rel="noopener noreferrer"><span aria-hidden="true">▶</span><span>{videoLink} ↗</span><span class="sr-only">（新窗口打开）</span></a>
				)}
			</div>}

			<div class="content-main">
				{isArticle && detailCover && <div class="content-article-cover">
					<ImageViewer src={detailCover} width={cover?.width} height={cover?.height} alt={`“${item.title}”的文章封面`} caption={`文章封面 · ${platform}`} />
				</div>}
				<section class="content-body" aria-labelledby="content-body-label">
					<h2 id="content-body-label"><span aria-hidden="true">01 /</span> {bodyLabel}</h2>
					{item.contentNote?.trim() && <p class="content-editor-note"><span>编辑说明：</span>{item.contentNote}</p>}
					{isVideo && <p class="content-video-caption">这里是视频简介。</p>}
					<div class="content-paragraphs" data-reader-body>
						{hasBlocks ? <ArticleBody blocks={item.blocks || []} /> : hasParagraphs ? item.paragraphs?.map((paragraph) => <p>{paragraph}</p>) : <>
							<p>{item.excerpt}</p>
							<p class="content-body-unavailable">这里只收录了简介，未整理完整正文。请前往原文查看。</p>
						</>}
					</div>
				</section>

				<footer class="content-source" data-reader-source>
					<div class="content-source-link"><span>原文在这里</span><a href={item.sourceUrl} target="_blank" rel="noopener noreferrer">{sourceLinkLabel} <span aria-hidden="true">↗</span><span class="sr-only">（新窗口打开）</span></a></div>
					<div class="content-source-details">
						<p class="content-source-label">出处与核对记录</p>
						<p>出处：{platform} · {item.sourceAuthor}</p>
						{item.publishedAt && <p>发布日期：<time datetime={item.publishedAt}>{item.publishedAt}</time></p>}
						<p>内容整理自本人公开发布，原文可能更新。</p>
						<p>核对日期：<time datetime={item.verifiedAt}>{item.verifiedAt}</time></p>
					</div>
				</footer>
			</div>

			<aside class="content-margin-note" aria-label="剪报小注" data-reader-secondary>
				<p class="content-note-label">页边小注 / {number}</p>
				<p class="content-note-topic">{item.topic}</p>
				{isShort && <p class="content-note-excerpt">{item.excerpt}</p>}
				<dl>
					<div><dt>出处</dt><dd>{platform} · {item.sourceAuthor}</dd></div>
					{item.publishedAt && <div><dt>发布</dt><dd><time datetime={item.publishedAt}>{item.publishedAt}</time></dd></div>}
				</dl>
				<span class="content-signature">禾冉 <i>/ heran</i></span>
			</aside>
		</div>

		<nav class="content-pagination" aria-label="继续翻阅" data-reader-pagination>
			<p><span aria-hidden="true">02 /</span> 接着翻一页</p>
			<div>
				{previous ? <a href={`/content/${previous.id}/`} rel="prev"><span>← 上一篇</span><strong>{previous.title}</strong></a> : <a href="/content/#content-catalog-title"><span>← 第一页</span><strong>回到内容目录</strong></a>}
				{next ? <a href={`/content/${next.id}/`} rel="next"><span>下一篇 →</span><strong>{next.title}</strong></a> : <a href="/content/#content-catalog-title"><span>这一册，暂时翻到这里</span><strong>回到内容目录 →</strong></a>}
			</div>
		</nav>
	</article>
</Base>

<style>
	.content-detail { padding: 28px 0 max(84px, env(safe-area-inset-bottom)); }
	.content-detail :is(h1, h2, p, dd, a) { overflow-wrap: anywhere; }
	.content-back { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; border-bottom: 1px solid var(--reader-rule); }
	.content-back a { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; color: var(--reader-accent); font-size: 12px; text-decoration: none; }
	.content-back > span { color: var(--reader-muted); font: 13px/1.8 var(--serif-zh); }
	.content-heading { max-width: 980px; padding: 42px 0; }
	.content-eyebrow { display: flex; align-items: center; gap: 21px; margin: 0 0 21px; color: var(--reader-leaf); font: 11px/1.8 var(--mono); }
	.content-entry-number { font: 56px/1 var(--serif-en); color: var(--reader-accent); }
	.content-heading h1 { max-width: 18em; margin: 0; font: 400 clamp(36px, 5.2vw, 64px)/1.24 var(--serif-zh); letter-spacing: -0.025em; text-wrap: pretty; }
	.content-excerpt { max-width: 35em; margin: 28px 0 0; padding-left: 14px; border-left: 1px solid var(--reader-rule); color: var(--reader-muted); font: 17px/1.9 var(--serif-zh); }
	/* 只在此页面细化工具条的外观，复用原有字号、专注与跳转逻辑。 */
	.content-detail :global(reader-preferences) { margin-bottom: 42px; padding-block: 7px; border-top-color: var(--reader-ink); }
	.content-detail :global(reader-preferences .reader-return), .content-detail :global(reader-preferences .reader-next) { color: var(--reader-accent); }
	.content-detail :global(reader-preferences .reader-size-panel) { padding: 21px; box-shadow: var(--shadow-paper, 0 12px 28px -24px var(--ink)); }
	.content-detail :global(reader-preferences :is(a, button, summary)) { transition: background var(--motion-fast, 160ms) ease; }
	.content-reading-layout { display: grid; grid-template-columns: minmax(0, 40rem) minmax(180px, 1fr); grid-template-rows: max-content 1fr; column-gap: clamp(28px, 5vw, 70px); row-gap: 28px; align-items: start; }
	.content-main { grid-column: 1; grid-row: 1 / 3; width: 100%; min-width: 0; max-width: 40rem; }
	.is-article .content-margin-note { grid-row: 1; }
	.content-article-cover { min-width: 0; margin-bottom: 42px; }
	.content-media { grid-column: 2; grid-row: 1; min-width: 0; }
	.content-margin-note { grid-column: 2; grid-row: 2; max-width: 16rem; padding: 14px 0 14px 21px; border-left: 1px solid var(--reader-rule); color: var(--reader-muted); }
	.content-detail:not(.has-image):not(.is-video) .content-margin-note { grid-row: 1; }
	.content-note-label { margin: 0 0 14px; font: 10px/1.8 var(--mono); color: var(--reader-accent); }
	.content-note-topic { margin: 0 0 14px; font: 22px/1.5 var(--serif-zh); color: var(--reader-ink); }
	.content-note-excerpt { margin: 0 0 21px; font: 14px/1.8 var(--serif-zh); }
	.content-margin-note dl { margin: 0; font-size: 12px; line-height: 1.8; }
	.content-margin-note dl > div { margin-top: 10px; }
	.content-margin-note dt { color: var(--reader-leaf); font: 10px/1.8 var(--mono); }
	.content-margin-note dd { margin: 2px 0 0; }
	.content-signature { display: block; margin-top: 28px; color: var(--reader-ink); font: 20px/1.5 var(--serif-zh); }
	.content-signature i { color: var(--reader-muted); font-family: var(--serif-en); }
	.content-body h2 { display: flex; align-items: baseline; gap: 7px; margin: 0 0 28px; font: 11px/1.8 var(--mono); color: var(--reader-muted); font-weight: 400; }
	.content-body h2::after { content: ''; flex: 1; margin-left: 14px; border-top: 1px solid var(--reader-rule); }
	.content-body h2 > span { margin-right: 8px; color: var(--reader-accent); }
	.content-editor-note { margin: -7px 0 28px; padding-left: 14px; border-left: 1px solid var(--reader-rule); color: var(--reader-muted); font: 12px/1.9 var(--sans); }
	.content-editor-note > span { color: var(--reader-leaf); }
	.content-paragraphs p { margin: 0 0 1.2em; white-space: pre-wrap; }
	.content-paragraphs > p:last-child { margin-bottom: 0; }
	.content-paragraphs :global(.article-blocks h3) { margin-block: 2.3em 0.85em; font-size: 1.45em; line-height: 1.45; letter-spacing: -0.015em; }
	.content-paragraphs :global(.article-blocks blockquote) { border-left: 1px solid var(--reader-accent); padding-left: 1.2em; }
	.content-paragraphs :global(.article-blocks pre) { border-radius: 0; padding: 21px; }
	.content-paragraphs :global(.article-blocks .article-image) { margin-block: 2em; }
	.content-paragraphs .content-body-unavailable { border-left: 2px solid var(--reader-rule); padding-left: 14px; color: var(--reader-muted); font-size: 0.85em; }
	.content-video-caption { margin: 0 0 18px; color: var(--reader-muted); font-size: 13px; }
	.is-video .content-media { grid-column: 1; grid-row: 1; }
	.is-video .content-main { grid-row: 2; }
	.is-video .content-margin-note { grid-row: 1 / 3; }
	.content-video-entry { display: flex; align-items: center; gap: 18px; min-height: 100px; padding: 22px; background: var(--reader-wash); color: var(--reader-accent); font: 18px/1.5 var(--serif-zh); text-decoration: none; }
	.content-video-entry > span:first-child { font-size: 30px; }
	.content-video-entry:hover { color: var(--reader-ink); }
	.content-source { margin-top: 42px; border-top: 1px solid var(--reader-rule); padding-top: 14px; }
	.content-source-link { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px 20px; }
	.content-source-link > span { color: var(--reader-muted); font: 14px var(--serif-zh); }
	.content-source-link a { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; color: var(--reader-accent); font-size: 14px; text-decoration-thickness: 1px; text-underline-offset: 5px; }
	.content-source-details { margin-top: 14px; padding-top: 14px; border-top: 1px dashed var(--reader-rule); color: var(--reader-muted); font-size: 11px; }
	.content-source-details p { margin: 7px 0; line-height: 1.8; }
	.content-source-details .content-source-label { margin: 0 0 14px; font: 10px/1.8 var(--mono); color: var(--reader-accent); }
	.content-pagination { margin-top: 70px; padding-top: 21px; border-top: 1px solid var(--reader-ink); }
	.content-pagination > p { margin: 0 0 16px; color: var(--reader-muted); font: 12px var(--mono); }
	.content-pagination > p span { color: var(--reader-accent); margin-right: 8px; }
	.content-pagination > div { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 56px; }
	.content-pagination a { display: block; min-height: 98px; padding: 14px 0; text-decoration: none; }
	.content-pagination a + a { padding-left: 28px; border-left: 1px solid var(--reader-rule); }
	.content-pagination a > span { display: block; color: var(--reader-accent); font: 11px/1.8 var(--mono); }
	.content-pagination strong { display: block; max-width: 22em; margin-top: 14px; font: 400 24px/1.5 var(--serif-zh); text-wrap: pretty; }
	.content-pagination a:hover strong { text-decoration: underline; text-underline-offset: 5px; }
	.content-detail[data-focused='true'] .content-heading { max-width: 40rem; margin-inline: auto; }
	.content-detail[data-focused='true'] .content-reading-layout { display: flex; flex-direction: column; max-width: 40rem; margin-inline: auto; }
	.content-detail[data-focused='true'] .content-media { width: 100%; max-width: 500px; margin-inline: auto; }
	.content-detail[data-focused='true'] .content-main { width: 100%; }
	.content-detail.is-article[data-focused='true'] :is(.content-heading, .content-reading-layout) { max-width: 40rem; }
	@media (max-width: 760px) {
		.content-detail { padding: 20px 0 max(48px, env(safe-area-inset-bottom)); }
		.content-heading { padding: 28px 0; }
		.content-detail :global(reader-preferences) { margin-bottom: 28px; }
		.content-heading h1 { font-size: clamp(32px, 6.5vw, 46px); line-height: 1.28; }
		.content-eyebrow { gap: 14px; margin-bottom: 16px; }
		.content-entry-number { font-size: 40px; }
		.content-excerpt { margin-top: 18px; font-size: 16px; }
		.content-reading-layout { display: flex; flex-direction: column; gap: 28px; }
		.content-reading-layout > * { width: 100%; }
		.content-media { order: 1; max-width: 40rem; }
		.content-main { order: 2; }
		.content-margin-note { order: 3; max-width: 40rem; margin-top: 0; padding: 21px 0 0; border-left: 0; border-top: 1px solid var(--reader-rule); }
		.content-note-label { margin-bottom: 7px; }
		.content-note-topic { font-size: 18px; }
		.content-margin-note dl { display: flex; flex-wrap: wrap; gap: 8px 24px; }
		.content-signature { margin-top: 12px; }
		.content-pagination { margin-top: 32px; }
		.content-pagination > div { grid-template-columns: 1fr; gap: 0; }
		.content-pagination a + a { padding-left: 0; border-left: 0; border-top: 1px solid var(--reader-rule); }
		.content-pagination strong { font-size: 21px; }
		.content-paragraphs :global(.article-blocks h3) { font-size: 1.3em; }
		.content-paragraphs :global(.article-blocks pre) { padding: 14px; }
	}
	@media (prefers-reduced-motion: reduce) {
		.content-detail :global(reader-preferences :is(a, button, summary)) { transition: none; }
	}
</style>
