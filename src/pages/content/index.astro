---
import { getCollection } from 'astro:content';
import AccountCards from '../../components/content/AccountCards.astro';
import LibraryCard from '../../components/content/LibraryCard.astro';
import { library, platformLabels } from '../../data/library';
import Base from '../../layouts/Base.astro';
import { ymd } from '../../lib/date';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const lead = library.find((item) => item.featured) || library[0];
const items = lead ? [lead, ...library.filter((item) => item !== lead)] : [];
const platforms = ['xiaohongshu', 'x', 'bilibili', 'wechat'] as const;
const filters = [
	{ id: 'all', label: '全部' },
	...platforms.map((id) => ({ id, label: platformLabels[id] })),
	{ id: 'blog', label: '站内文章' },
];
---

<Base title="内容" description="公开笔记、帖子、视频和公众号文章的剪报册。保留原题、正文与出处，也收着站内写过的文章。">
	<div class="content-index">
		<header class="content-hero">
			<div class="content-intro">
				<p class="content-eyebrow">内容剪报册 <span aria-hidden="true">/</span> CLIPPINGS</p>
				<h1>写下的，<br />做过的。</h1>
				<p class="content-deck">笔记、帖子、视频，还有文章。<br />把散在不同地方的内容，收在同一册里。</p>
				<p class="content-hero-note">保留原题与出处，能在这里读，也能回到原文。</p>
			</div>
			<aside class="content-overview" aria-label="内容收录总览">
				<div class="content-overview-top"><span>本册目录</span><span aria-hidden="true">INDEX / 01</span></div>
				<p class="content-overview-count"><strong>{library.length}</strong><span>条公开内容<br />按出处归档</span></p>
				<dl>
					{platforms.map((platform) => (
						<div><dt>{platformLabels[platform]}</dt><dd>{library.filter((item) => item.platform === platform).length} 条</dd></div>
					))}
				</dl>
				<p class="content-overview-foot">另有 {posts.length} 篇站内文章，放在册末。</p>
			</aside>
		</header>

		<content-library class="content-library" data-view="illustrated">
			<div class="content-catalog-heading">
				<h2 id="content-catalog-title">翻阅内容</h2>
				<span>按平台找，或搜一个词。</span>
			</div>
			<div class="content-controls" data-library-controls hidden>
				<div class="content-platforms" role="group" aria-label="按平台筛选">
					{filters.map((filter) => (
						<button type="button" data-filter={filter.id} aria-pressed={filter.id === 'all' ? 'true' : 'false'} aria-controls="content-results">{filter.label}</button>
					))}
				</div>
				<form class="content-search" role="search" aria-label="搜索内容">
					<label for="content-search-input">搜索标题、主题或简介</label>
					<div class="content-search-field">
						<input id="content-search-input" type="search" name="q" placeholder="试试 AI、工作流…" autocomplete="off" aria-controls="content-results" />
						<span aria-hidden="true">⌕</span>
					</div>
				</form>
			</div>
			<noscript><p class="content-nojs">下面列出全部内容；开启 JavaScript 后可按平台筛选和搜索。</p></noscript>
			<div class="content-result-heading">
				<p class="content-result-count" data-library-status role="status" aria-live="polite" aria-atomic="true">{library.length} 条公开内容 · {posts.length} 篇站内文章</p>
				<div class="content-views" data-library-views role="group" aria-label="翻阅方式" hidden>
					<button type="button" data-view="illustrated" aria-pressed="true" aria-controls="content-results">图文</button>
					<button type="button" data-view="catalog" aria-pressed="false" aria-controls="content-results">目录</button>
				</div>
			</div>

			<div id="content-results" aria-labelledby="content-catalog-title">
				<div class="content-grid">
					{items.map((item, index) => <LibraryCard item={item} index={index} lead={item === lead} />)}
				</div>
				<section class="content-empty" data-library-empty hidden aria-labelledby="content-empty-title">
					<span class="content-empty-mark" aria-hidden="true">—</span>
					<h3 id="content-empty-title">这一页暂时是空的。</h3>
					<p>没有找到匹配的内容。换个关键词，或回到全部内容。</p>
					<button type="button" data-library-reset>清除搜索与筛选 <span aria-hidden="true">↺</span></button>
				</section>
				{posts.length > 0 && (
					<section class="content-archive" data-library-archive aria-labelledby="content-archive-title">
						<header>
							<p class="content-eyebrow">册末 / 站内文章</p>
							<h2 id="content-archive-title">以前写在这里的。</h2>
							<p>仍在原来的地址，接着读就好。</p>
						</header>
						<ul>
							{posts.map((post) => (
								<li data-library-item data-platform="blog" data-search={`${post.data.title} ${post.data.description} 站内文章 英文`}>
									<a href={`/blog/${post.id}/`} lang="en">
										<span class="content-archive-meta"><time datetime={ymd(post.data.pubDate)}>{ymd(post.data.pubDate)}</time><span>EN / Article</span></span>
										<h3>{post.data.title}</h3>
										<p>{post.data.description}</p>
										<span class="content-archive-arrow" aria-hidden="true">↗</span>
									</a>
								</li>
							))}
						</ul>
					</section>
				)}
			</div>
		</content-library>

		<section class="content-accounts-section" aria-labelledby="content-accounts-title">
			<header>
				<p class="content-eyebrow">封底 / 账号入口</p>
				<h2 id="content-accounts-title">也可以在这些地方找到我</h2>
				<p>公众号扫码关注，其他平台可以直接去主页翻。</p>
			</header>
			<AccountCards />
		</section>
	</div>
</Base>

<script>
	class ContentLibraryElement extends HTMLElement {
		private cleanup?: () => void;

		connectedCallback() {
			if (this.cleanup) return;
			const controls = this.querySelector<HTMLElement>('[data-library-controls]');
			const input = this.querySelector<HTMLInputElement>('input[type="search"]');
			const status = this.querySelector<HTMLElement>('[data-library-status]');
			const empty = this.querySelector<HTMLElement>('[data-library-empty]');
			const views = this.querySelector<HTMLElement>('[data-library-views]');
			if (!controls || !input || !status || !empty || !views) return;

			const controller = new AbortController();
			const { signal } = controller;
			const buttons = Array.from(this.querySelectorAll<HTMLButtonElement>('[data-filter]'));
			const viewButtons = Array.from(views.querySelectorAll<HTMLButtonElement>('[data-view]'));
			const setView = (view: string) => {
				this.dataset.view = view === 'catalog' ? 'catalog' : 'illustrated';
				viewButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.view === this.dataset.view)));
			};
			const entries = Array.from(this.querySelectorAll<HTMLElement>('[data-library-item]'));
			const archive = this.querySelector<HTMLElement>('[data-library-archive]');
			const normalize = (text: string) => text.normalize('NFKC').toLocaleLowerCase('zh-CN');
			const searchable = entries.map((element) => ({ element, text: normalize(element.dataset.search || '') }));
			const initialPlatform = new URLSearchParams(window.location.search).get('platform') || 'all';
			let platform = buttons.some((button) => button.dataset.filter === initialPlatform) ? initialPlatform : 'all';

			const update = () => {
				const query = input.value.trim();
				const terms = normalize(query).split(/\s+/).filter(Boolean);
				let publicCount = 0;
				let blogCount = 0;
				searchable.forEach(({ element, text }) => {
					const match = (platform === 'all' || element.dataset.platform === platform) && terms.every((term) => text.includes(term));
					element.hidden = !match;
					if (match) {
						if (element.dataset.platform === 'blog') blogCount++;
						else publicCount++;
					}
				});
				buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.filter === platform)));
				if (archive) archive.hidden = blogCount === 0;
				empty.hidden = publicCount + blogCount > 0;
				const selected = buttons.find((button) => button.dataset.filter === platform)?.textContent || '全部';
				status.textContent = `${platform === 'all' ? '' : `${selected} · `}${query ? `搜索“${query}” · ` : ''}${publicCount} 条公开内容 · ${blogCount} 篇站内文章`;
			};

			buttons.forEach((button) => {
				button.addEventListener('click', () => { platform = button.dataset.filter || 'all'; update(); }, { signal });
			});
			viewButtons.forEach((button) => {
				button.addEventListener('click', () => setView(button.dataset.view || 'illustrated'), { signal });
			});
			input.addEventListener('input', update, { signal });
			this.querySelector('form')?.addEventListener('submit', (event) => { event.preventDefault(); update(); }, { signal });
			this.querySelector('[data-library-reset]')?.addEventListener('click', () => {
				platform = 'all';
				input.value = '';
				update();
				input.focus({ preventScroll: true });
			}, { signal });
			setView(this.dataset.view || 'illustrated');
			update();
			controls.hidden = false;
			views.hidden = false;
			this.cleanup = () => controller.abort();
		}

		disconnectedCallback() {
			this.cleanup?.();
			this.cleanup = undefined;
		}
	}

	if (!customElements.get('content-library')) customElements.define('content-library', ContentLibraryElement);
</script>

<style>
	.content-index { padding-bottom: calc(var(--unit, 14px) * 6); }
	.content-index :is(h1, h2, h3, p) { overflow-wrap: anywhere; }
	.content-hero { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 3fr); gap: clamp(42px, 7vw, 98px); align-items: end; padding: 56px 0 70px; }
	.content-hero > * { min-width: 0; }
	.content-eyebrow { margin: 0; font: 11px/1.8 var(--mono); letter-spacing: 0.06em; color: var(--accent); }
	.content-eyebrow > span { margin: 0 12px; color: var(--rule); }
	.content-intro h1 { margin: 28px 0; font-family: var(--serif-zh); font-size: clamp(48px, 6.8vw, 84px); font-weight: 400; line-height: 1.13; letter-spacing: -0.035em; }
	.content-deck { margin: 0; font-size: clamp(16px, 1.7vw, 19px); line-height: 1.9; color: var(--ink-2); text-wrap: pretty; }
	.content-hero-note { margin: 28px 0 0; padding-left: 14px; border-left: 1px solid var(--accent); font-size: 12px; line-height: 1.8; color: var(--ink-2); }
	.content-overview { position: relative; margin: 0 0 7px; padding: 21px 0 0 21px; border-left: 1px solid var(--rule); }
	.content-overview::before { content: ''; position: absolute; top: 0; left: 21px; width: 42px; border-top: 2px solid var(--accent); }
	.content-overview-top { display: flex; justify-content: space-between; gap: 12px; font-family: var(--mono); font-size: 10px; color: var(--ink-2); }
	.content-overview-count { display: flex; align-items: center; gap: 21px; margin: 28px 0; }
	.content-overview-count strong { font-family: var(--serif-en); font-size: 84px; font-weight: 400; line-height: 0.9; color: var(--accent); }
	.content-overview-count > span { font-size: 12px; line-height: 1.8; color: var(--ink-2); }
	.content-overview dl { margin: 0; }
	.content-overview dl > div { display: flex; justify-content: space-between; gap: 20px; padding: 10px 0; border-top: 1px dashed var(--rule); font-size: 13px; }
	.content-overview dd { margin: 0; font-family: var(--mono); font-size: 12px; }
	.content-overview-foot { margin: 16px 0 0; padding-top: 16px; border-top: 1px solid var(--rule); font-size: 11px; color: var(--ink-2); }
	.content-library { display: block; border-top: 1px solid var(--ink); padding-top: 28px; }
	.content-catalog-heading { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 14px 28px; align-items: baseline; margin-bottom: 28px; }
	.content-catalog-heading h2 { margin: 0; font-family: var(--serif-zh); font-size: 28px; font-weight: 400; line-height: 1.3; }
	.content-catalog-heading > span { font-size: 12px; color: var(--ink-2); }
	.content-controls { display: grid; grid-template-columns: minmax(0, 1fr) minmax(220px, 280px); align-items: end; gap: 24px; }
	.content-platforms { display: flex; flex-wrap: wrap; gap: 7px; }
	.content-platforms button, .content-empty button { min-height: 44px; padding: 8px 14px; border: 1px solid transparent; border-bottom-color: var(--rule); border-radius: 0; font: 13px/1.5 var(--sans); background: transparent; color: var(--ink-2); cursor: pointer; transition: color var(--motion-fast, 160ms) ease, border-color var(--motion-fast, 160ms) ease; }
	.content-platforms button[aria-pressed='true'] { color: var(--accent); border-bottom: 2px solid var(--accent); }
	.content-platforms button:hover { color: var(--ink); border-bottom-color: var(--ink); }
	.content-search label { display: block; margin-bottom: 6px; font-size: 11px; color: var(--ink-2); }
	.content-search-field { position: relative; }
	.content-search input { width: 100%; min-width: 0; min-height: 44px; padding: 10px 40px 10px 0; border: 0; border-bottom: 1px solid var(--ink-2); border-radius: 0; background: transparent; color: var(--ink); font: 14px/1.5 var(--sans); }
	.content-search input::placeholder { color: var(--ink-2); }
	.content-search-field > span { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); pointer-events: none; font-size: 24px; color: var(--ink-2); }
	.content-platforms button:focus-visible, .content-search input:focus-visible, .content-empty button:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
	.content-result-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 7px 21px; margin: 21px 0 28px; }
	.content-result-count { margin: 0; font: 11px/1.8 var(--mono); color: var(--ink-2); }
	.content-views { display: flex; gap: 0; border: 1px solid var(--rule); }
	.content-views button { min-width: 56px; min-height: 44px; padding: 7px 14px; border: 0; background: transparent; color: var(--ink-2); font: 12px/1.5 var(--sans); cursor: pointer; transition: background var(--motion-fast, 160ms) ease; }
	.content-views button + button { border-left: 1px solid var(--rule); }
	.content-views button[aria-pressed='true'] { background: var(--paper-3); color: var(--accent); }
	.content-views button:hover { color: var(--ink); }
	.content-views button:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
	.content-nojs { margin: 0; font-size: 13px; color: var(--ink-2); }
	.content-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 56px clamp(28px, 4.5vw, 56px); align-items: start; }
	.content-library[data-view='catalog'] .content-grid { grid-template-columns: minmax(0, 1fr); gap: 0; border-top: 1px solid var(--rule); }
	.content-empty { padding: 48px 24px; border: 1px dashed var(--rule); text-align: center; }
	.content-empty-mark { color: var(--accent); font-family: var(--serif-en); font-size: 32px; }
	.content-empty h3 { margin: 8px 0; font-family: var(--serif-zh); font-size: 26px; font-weight: 400; }
	.content-empty p { margin: 0 0 22px; font-size: 14px; color: var(--ink-2); }
	.content-empty button { color: var(--accent); }
	.content-archive { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: 56px; margin-top: 70px; padding-top: 28px; border-top: 1px solid var(--rule); }
	.content-archive > * { min-width: 0; }
	.content-archive h2 { margin: 12px 0 10px; font-family: var(--serif-zh); font-size: 28px; line-height: 1.4; font-weight: 400; }
	.content-archive header > p:last-child { margin: 0; font-size: 13px; color: var(--ink-2); }
	.content-archive ul { list-style: none; padding: 0; margin: 0; }
	.content-archive li + li { border-top: 1px dashed var(--rule); }
	.content-archive a { position: relative; display: block; padding: 22px 28px 22px 0; text-decoration: none; }
	.content-archive li:first-child a { padding-top: 0; }
	.content-archive-meta { display: flex; flex-wrap: wrap; gap: 12px; font-family: var(--mono); font-size: 10px; color: var(--ink-2); }
	.content-archive h3 { margin: 10px 0; font-family: var(--serif-en); font-size: 27px; font-weight: 400; line-height: 1.3; }
	.content-archive a > p { margin: 0; font-size: 13px; line-height: 1.8; color: var(--ink-2); }
	.content-archive-arrow { position: absolute; right: 0; top: 50%; color: var(--accent); }
	.content-archive a:hover h3 { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
	.content-archive a:focus-visible { outline: 2px solid var(--accent); outline-offset: 5px; }
	.content-accounts-section { margin-top: 84px; padding-top: 28px; border-top: 1px solid var(--ink); }
	.content-accounts-section header { margin-bottom: 28px; }
	.content-accounts-section h2 { margin: 12px 0 8px; font-family: var(--serif-zh); font-size: clamp(24px, 3vw, 30px); font-weight: 400; line-height: 1.4; }
	.content-accounts-section header > p:last-child { margin: 0; font-size: 13px; color: var(--ink-2); }
	@media (max-width: 860px) {
		.content-hero { gap: 32px; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); padding: 44px 0 56px; }
		.content-overview { padding: 21px 0 0 21px; }
		.content-overview-top { flex-wrap: wrap; }
		.content-controls { grid-template-columns: 1fr; gap: 18px; }
		.content-search { max-width: 380px; }
		.content-archive { grid-template-columns: 1fr; gap: 28px; }
	}
	@media (max-width: 760px) {
		.content-grid { grid-template-columns: minmax(0, 1fr); gap: 42px; }
	}
	@media (max-width: 600px) {
		.content-hero { grid-template-columns: minmax(0, 1fr); gap: 36px; }
		.content-intro h1 { margin: 20px 0; font-size: clamp(48px, 12vw, 68px); }
		.content-overview { margin: 0; padding: 21px; border: 1px solid var(--rule); background: var(--paper-2); box-shadow: var(--shadow-paper, 0 12px 28px -24px var(--ink)); }
		.content-overview::before { top: -1px; }
		.content-overview-count { margin: 24px 0; }
		.content-overview-count strong { font-size: 72px; }
		.content-overview-top { justify-content: space-between; }
		.content-platforms { gap: 6px; }
		.content-platforms button { padding: 8px 12px; }
		.content-search { max-width: none; }
		.content-archive { margin-top: 44px; }
		.content-accounts-section { margin-top: 48px; }
		.content-index { padding-bottom: 48px; }
	}
	@media (prefers-reduced-motion: reduce) {
		.content-platforms button, .content-empty button, .content-views button { transition: none; }
	}
	/* 筛选状态在所有布局规则之后，无 JS 控件也不能被 display:grid 重新显示。 */
	.content-controls[hidden], .content-views[hidden], .content-empty[hidden], .content-archive[hidden], .content-archive li[hidden] { display: none !important; }
</style>
