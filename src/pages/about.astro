---
import Todo from '../components/Todo.astro';
import AccountCards from '../components/AccountCards.astro';
import { profile } from '../data/profile';
import Base from '../layouts/Base.astro';
---

<Base title="关于" description="关于禾冉（heran）：做增长运营，也自己写工具。这里放作品、使用记录和公开联系方式。">
	<section class="row first">
		<header>
			<h1>关于</h1>
			<span class="mono">{profile.name} · {profile.nameEn}</span>
		</header>
		<div class="prose" style="padding-top:0">
			{profile.intro ? <p>{profile.intro}</p> : <p><Todo label="一段 100 字以内的自我介绍" where="关于页" /></p>}
			<dl class="facts">
				<div><dt>署名</dt><dd>{profile.name} / {profile.nameEn}</dd></div>
				{profile.facts.map((f) => <div><dt>{f.k}</dt><dd>{f.v}</dd></div>)}
			</dl>
		</div>
	</section>

	<section class="row">
		<header>
			<h2>作品进展</h2>
			<span class="mono">做过的 · 在做的</span>
		</header>
		<ol class="timeline">
			{
				profile.timeline.map((t) => (
					<li>
						<span class="mono">{t.when}</span>
						<div>
							<h3>{'href' in t && t.href ? <a href={t.href}>{t.title}</a> : t.title}</h3>
							<p>{t.desc}</p>
						</div>
					</li>
				))
			}
		</ol>
	</section>

	<section class="row">
		<header>
			<h2>会做的事</h2>
		</header>
		<ul class="tags">
			{profile.skills.map((s) => <li>{s}</li>)}
		</ul>
	</section>

	<section class="row" id="contact">
		<header>
			<h2>联系</h2>
			<span class="mono">邮件最快</span>
		</header>
		<div>
			<div class="mail">
				<a href={`mailto:${profile.email}`}>{profile.email}</a>
				<button class="copy" type="button" data-copy={profile.email}>复制</button>
			</div>
			<div style="margin-top:28px"><AccountCards /></div>
		</div>
	</section>
</Base>
