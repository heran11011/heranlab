---
import { profile } from '../data/profile';
import Base from '../layouts/Base.astro';

const x = profile.platforms.find((p) => p.id === 'x');
const github = profile.platforms.find((p) => p.id === 'github');
---

<Base title="页面不存在" description="这个页面不存在。" noindex>
	<section class="lost">
		<span class="mono">404</span>
		<h1>这页不存在。</h1>
		<p>可能是地址打错了，也可能是被我挪走了。</p>
		{x?.href && <p class="mono" style="margin-top:6px">X <a href={x.href}>{x.name}</a>{github?.href && <> · GitHub <a href={github.href}>{github.name}</a></>}</p>}
		<div class="btns">
			<a class="btn solid" href="/">回首页</a>
			<a class="btn" href="/work/">看作品</a>
		</div>
	</section>
</Base>
