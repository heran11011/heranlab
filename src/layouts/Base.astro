---
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ReadingTools from '../components/ReadingTools.astro';
import { SITE_TITLE } from '../consts';

interface Props {
	title?: string; // 不传 = 首页，只显示站名
	description: string;
	lang?: string;
	image?: ImageMetadata;
	type?: 'website' | 'article';
	noindex?: boolean;
}
const { title, description, lang = 'zh-CN', image, type, noindex } = Astro.props;
const fullTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={fullTitle} description={description} image={image} type={type} noindex={noindex} />
	</head>
	<body id="page-top">
		<a class="skip-link" href="#main">跳到正文</a>
		<Header />
		<main id="main" class="wrap" tabindex="-1">
			<slot />
		</main>
		<Footer />
		<ReadingTools />
		<script>
			// 状态由独立播报区反馈；连点不会把“已复制”当成默认文案。
			const announcement = document.createElement('span');
			announcement.className = 'sr-only';
			announcement.setAttribute('role', 'status');
			announcement.setAttribute('aria-atomic', 'true');
			document.body.append(announcement);
			document.querySelectorAll<HTMLButtonElement>('button.copy').forEach((b) => {
				const label = b.textContent;
				let timeout: ReturnType<typeof setTimeout>;
				let request = 0;
				b.dataset.copyReady = '';
				b.addEventListener('click', async () => {
					const id = ++request;
					const source = b.previousElementSibling;
					const text = (b.dataset.copy || source?.textContent || '').trim();
					let state = 'copied';
					try { await navigator.clipboard.writeText(text); }
					catch {
						state = 'manual';
						if (id === request && source?.textContent?.trim() === text) {
							const selection = getSelection();
							const range = document.createRange(); range.selectNodeContents(source);
							selection?.removeAllRanges(); selection?.addRange(range);
						}
					}
					if (id !== request) return;
					clearTimeout(timeout);
					b.dataset.copyState = state;
					b.textContent = state === 'copied' ? '已复制' : '手动复制';
					announcement.textContent = state === 'copied' ? '已复制到剪贴板' : '无法自动复制，请手动复制文字。';
					timeout = setTimeout(() => { b.textContent = label; delete b.dataset.copyState; announcement.textContent = ''; }, 1700);
				});
			});
		</script>
	</body>
</html>
