---
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ReadingTools from '../components/ReadingTools.astro';
import { SITE_TITLE } from '../consts';

interface Props {
	title?: string; // 不传 = 首页，只显示站名
	description: string;
	lang?: string;
	image?: ImageMetadata;
	type?: 'website' | 'article';
	noindex?: boolean;
}
const { title, description, lang = 'zh-CN', image, type, noindex } = Astro.props;
const fullTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={fullTitle} description={description} image={image} type={type} noindex={noindex} />
	</head>
	<body id="page-top">
		<a class="skip-link" href="#main">跳到正文</a>
		<Header />
		<main id="main" class="wrap" tabindex="-1">
			<slot />
		</main>
		<Footer />
		<ReadingTools />
		<script>
			// 复制按钮：data-copy 优先，否则复制前一个元素的文字
			document.querySelectorAll<HTMLButtonElement>('button.copy').forEach((b) => {
				b.addEventListener('click', async (e) => {
					e.preventDefault();
					const text = b.dataset.copy || b.previousElementSibling?.textContent || '';
					try {
						await navigator.clipboard.writeText(text.trim());
					} catch {
						const old = b.textContent;
						b.textContent = '请手动复制';
						setTimeout(() => (b.textContent = old), 1400);
						return;
					}
					const old = b.textContent;
					b.textContent = '已复制';
					setTimeout(() => (b.textContent = old), 1400);
				});
			});
		</script>
	</body>
</html>
