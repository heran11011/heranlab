---
import { profile } from '../data/profile';
import HeaderLink from './HeaderLink.astro';
---

<header class="top">
	<div class="wrap">
		<a class="brand" href="/"><b>{profile.name}</b><span class="mono">{profile.nameEn.toUpperCase()}</span></a>
		<span class="mono where">{profile.cityEn}</span>
		<nav class="nav" aria-label="主导航">
			<HeaderLink href="/work/">作品</HeaderLink>
			<HeaderLink href="/blog/">文章</HeaderLink>
			<HeaderLink href="/about/">关于</HeaderLink>
		</nav>
	</div>
</header>
