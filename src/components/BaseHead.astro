---
// 全站 <head>：样式、字体、GA、SEO 基础项（标题、描述、canonical、分享卡片）
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { Font } from 'astro:assets';
import { BLOG_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	type?: 'website' | 'article';
	noindex?: boolean;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description, image, type = 'website', noindex = false } = Astro.props;
// 分享图待补：没有图时用小卡片样式，不再用 starter 自带的占位图
const imageURL = image ? new URL(image.src, Astro.site).href : undefined;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />

<!-- 仅正式域名统计；本地设计预览和分支预览不发送分析请求。 -->
<script is:inline>
	(() => {
		if (!['heranlab.com', 'www.heranlab.com'].includes(location.hostname)) return;
		window.dataLayer = window.dataLayer || [];
		function gtag() { window.dataLayer.push(arguments); }
		gtag('js', new Date());
		gtag('config', 'G-6K0DQ1M668');
		const script = document.createElement('script');
		script.async = true;
		script.src = 'https://www.googletagmanager.com/gtag/js?id=G-6K0DQ1M668';
		document.head.appendChild(script);
	})();
</script>

<!-- 原头像透明圆角方形；与站内头像保持同一圆角比例，版本参数刷新页签缓存 -->
<link rel="icon" type="image/png" href="/social/avatar-soft-square.png?v=20261114-square" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={BLOG_TITLE} href={new URL('rss.xml', Astro.site)} />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#f5f2e9" />
<script is:inline>
	// 首次绘制前恢复本人选择的配色；存储被禁用时保持默认暖纸。
	(() => {
		try {
			const tone = localStorage.getItem('heran-tone');
			const colors = { paper: '#f5f2e9', forest: '#eff3eb', night: '#1c211d' };
			if (Object.hasOwn(colors, tone)) {
				document.documentElement.dataset.tone = tone;
				document.querySelector('meta[name="theme-color"]')?.setAttribute('content', colors[tone]);
			}
		} catch {}
	})();
</script>
{noindex && <meta name="robots" content="noindex" />}

<Font cssVariable="--font-instrument" preload />
<Font cssVariable="--font-jetbrains" />

<link rel="canonical" href={canonicalURL} />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content="禾冉 heran" />

<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content="禾冉 heran" />
{imageURL && <meta property="og:image" content={imageURL} />}

<meta name="twitter:card" content={imageURL ? 'summary_large_image' : 'summary'} />
<meta name="twitter:site" content="@heran_ai" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{imageURL && <meta name="twitter:image" content={imageURL} />}
