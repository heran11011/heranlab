---
// 全站 <head>：样式、字体、GA、SEO 基础项（标题、描述、canonical、分享卡片）
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { Font } from 'astro:assets';
import { BLOG_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	type?: 'website' | 'article';
	noindex?: boolean;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description, image, type = 'website', noindex = false } = Astro.props;
// 分享图待补：没有图时用小卡片样式，不再用 starter 自带的占位图
const imageURL = image ? new URL(image.src, Astro.site).href : undefined;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />

<!-- Google Analytics -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-6K0DQ1M668"></script>
<script is:inline>
	window.dataLayer = window.dataLayer || [];
	function gtag() {
		dataLayer.push(arguments);
	}
	gtag('js', new Date());
	gtag('config', 'G-6K0DQ1M668');
</script>

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={BLOG_TITLE} href={new URL('rss.xml', Astro.site)} />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#f5f2e9" />
{noindex && <meta name="robots" content="noindex" />}

<Font cssVariable="--font-instrument" preload />
<Font cssVariable="--font-jetbrains" />

<link rel="canonical" href={canonicalURL} />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content="禾冉 Heran" />

<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content="禾冉 Heran" />
{imageURL && <meta property="og:image" content={imageURL} />}

<meta name="twitter:card" content={imageURL ? 'summary_large_image' : 'summary'} />
<meta name="twitter:site" content="@heran_ai" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{imageURL && <meta name="twitter:image" content={imageURL} />}
