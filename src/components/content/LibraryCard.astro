---
import { libraryFormats, platformLabels } from '../../data/library';
import type { LibraryItem } from '../../data/library';

interface Props {
	item: LibraryItem;
	index: number;
	lead?: boolean;
}

const { item, index, lead = false } = Astro.props;
const platform = platformLabels[item.platform];
const format = libraryFormats[item.format];
const searchText = [item.title, item.topic, item.excerpt, platform, format].join(' ');
const videoPlaybackLabel = item.platform === 'bilibili' ? '去 B 站播放' : item.platform === 'xiaohongshu' ? '去小红书看视频' : '去 X 看视频';
const videoSourceLabel = item.platform === 'xiaohongshu' ? '小红书原视频' : `${platform} 原视频`;
---

<article
	class:list={['library-card', { 'library-card--lead': lead, 'library-card--illustrated': !!item.cover }]}
	data-library-item
	data-platform={item.platform}
	data-search={searchText}
>
	{item.cover && (
		<div class="library-card-cover">
			<img src={item.cover} alt={`“${item.title}”的配图`} loading="lazy" decoding="async" />
			{item.format === 'video' && <span class="library-video-label">视频 · {videoPlaybackLabel}</span>}
		</div>
	)}
	<div class="library-card-copy">
		<div class="library-card-topline">
			<span class="library-card-platform">{platform} / {format}</span>
			<span class="library-card-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
		</div>
		<p class="library-card-topic">{item.topic}</p>
		<h3><a href={`/content/${item.id}/`}>{item.title}</a></h3>
		<p class="library-card-excerpt">{item.excerpt}</p>
		{item.publishedAt && <p class="library-card-date">发布于 <time datetime={item.publishedAt}>{item.publishedAt}</time></p>}
		<div class="library-card-actions">
			<a class="library-card-read" href={`/content/${item.id}/`} aria-label={`站内阅读：${item.title}`}>
				站内阅读 <span aria-hidden="true">→</span>
			</a>
			<a href={item.sourceUrl} target="_blank" rel="noopener noreferrer" aria-label={`查看原文：${item.title}（新窗口打开）`}>
				{item.format === 'video' ? videoSourceLabel : '原文'} <span aria-hidden="true">↗</span>
			</a>
		</div>
	</div>
</article>

<style>
	.library-card {
		position: relative;
		display: flex;
		flex-direction: column;
		min-width: 0;
		border: 1px solid var(--rule);
		border-radius: var(--r);
		background: var(--paper-2);
		box-shadow: 0 2px 0 -1px var(--rule);
		transition: border-color 0.2s ease, transform 0.2s ease;
	}
	.library-card:not(.library-card--illustrated) .library-card-copy { min-height: 320px; }
	.library-card-cover { position: relative; border-bottom: 1px solid var(--rule); overflow: hidden; border-radius: var(--r) var(--r) 0 0; }
	.library-card-cover img { width: 100%; height: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: top center; }
	.library-video-label { position: absolute; left: 14px; bottom: 14px; max-width: calc(100% - 28px); padding: 4px 9px; background: var(--paper-2); color: var(--ink); font-family: var(--mono); font-size: 11px; border: 1px solid var(--rule); }
	.library-card-copy { display: flex; flex: 1; flex-direction: column; min-width: 0; padding: 24px; }
	.library-card-topline { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; font-family: var(--mono); font-size: 11px; letter-spacing: 0.03em; color: var(--ink-2); }
	.library-card-platform { overflow-wrap: anywhere; }
	.library-card-number { flex: none; color: var(--ink-2); }
	.library-card-topic { margin: 22px 0 9px; font-size: 12px; color: var(--accent); }
	.library-card h3 { margin: 0; font-family: var(--serif-zh); font-size: clamp(23px, 2.3vw, 29px); font-weight: 400; line-height: 1.4; text-wrap: pretty; overflow-wrap: anywhere; }
	.library-card h3 a { text-decoration: none; }
	.library-card h3 a:hover { text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 1px; }
	.library-card-excerpt { margin: 16px 0 0; font-size: 14px; color: var(--ink-2); line-height: 1.85; text-wrap: pretty; overflow-wrap: anywhere; }
	.library-card-date { margin: 16px 0 0; font-family: var(--mono); font-size: 11px; color: var(--ink-2); }
	.library-card-actions { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-top: auto; padding-top: 24px; font-size: 13px; }
	.library-card-actions a { display: inline-flex; align-items: center; gap: 9px; min-height: 32px; color: var(--ink-2); text-decoration: none; text-underline-offset: 4px; }
	.library-card-actions a:hover { text-decoration: underline; color: var(--accent); }
	.library-card-actions .library-card-read { color: var(--accent); }
	.library-card a:focus-visible { outline: 2px solid var(--accent); outline-offset: 5px; border-radius: 2px; }
	.library-card--lead { grid-column: 1 / -1; border-top: 3px solid var(--ink); }
	.library-card--lead .library-card-copy { padding: clamp(24px, 3vw, 38px); }
	.library-card--lead h3 { font-size: clamp(29px, 3.5vw, 42px); max-width: 24em; }
	.library-card--lead .library-card-excerpt { max-width: 48em; font-size: 15px; }
	.library-card--lead.library-card--illustrated { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); }
	.library-card--lead .library-card-cover { border-bottom: 0; border-right: 1px solid var(--rule); border-radius: 0 0 0 var(--r); }
	.library-card--lead .library-card-cover img { aspect-ratio: auto; min-height: 100%; max-height: 520px; }
	@media (hover: hover) and (pointer: fine) {
		.library-card:hover { border-color: var(--ink-2); transform: translateY(-2px); }
	}
	@media (max-width: 760px) {
		.library-card--lead.library-card--illustrated { display: flex; }
		.library-card--lead .library-card-cover { border-right: 0; border-bottom: 1px solid var(--rule); border-radius: 0; }
		.library-card--lead .library-card-cover img { aspect-ratio: 16 / 10; min-height: 0; max-height: none; }
	}
	@media (prefers-reduced-motion: reduce) {
		.library-card { transition: none; }
		.library-card:hover { transform: none; }
	}
	/* Astro 会给双 class 选择器重复加 scope，提高其优先级；hidden 必须明确胜出。 */
	.library-card[hidden] { display: none !important; }
</style>
