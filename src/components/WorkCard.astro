---
import type { CollectionEntry } from 'astro:content';
import Shot from './Shot.astro';
import Todo from './Todo.astro';

interface Props {
	work: CollectionEntry<'work'>;
	index: number;
	wide?: boolean;
	class?: string;
}
const { work, index, wide = false, class: cls } = Astro.props;
const d = work.data;
const href = `/work/${work.id}/`;
const where = `作品 ${work.id}`;
const ext = d.links.find((l) => l.href.startsWith('http'));
---

<article class:list={['card', { wide }, cls]}>
	<Shot src={d.cover} alt={d.title} placeholder={d.coverTodo} where={where} />
	<div class="body">
		<span class="mono">{String(index).padStart(2, '0')} · {d.kind} · {d.period}</span>
		<h3><a class="stretch" href={href}>{d.title}</a>{d.titleTodo && <Todo label={d.titleTodo} where={where} />}</h3>
		<p>{d.summary}</p>
		{
			d.command && (
				<div class="cmd">
					<code>{d.command.text}</code>
					<button class="copy" type="button">复制</button>
				</div>
			)
		}
		<span class="go">
			<span>看详情 →</span>
			{d.command && ext && <a class="ext" href={ext.href} target="_blank" rel="noopener">{ext.label} ↗</a>}
		</span>
	</div>
</article>
