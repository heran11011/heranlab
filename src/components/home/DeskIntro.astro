---
import { profile } from '../../data/profile';
import ContentDeck from './ContentDeck.astro';
---
<header class="desk-intro" id="hello">
	<div class="desk-owner">
		<a class="owner-label" href="/about/"><img src="/social/avatar-soft-square.png" alt="禾冉的头像" width="40" height="40" decoding="async" /><span>禾冉的个人网站</span></a>
		<h1>{profile.nameEn}<span>.</span></h1>
		<p class="desk-lead">写下来的，和做出来的。</p>
		<p class="desk-description">AI 使用笔记、日常观察，<br />还有自己做的小工具和视频。</p>
		<a class="desk-start" href="#writing">往下逛逛 <span aria-hidden="true">↓</span></a>
	</div>
	<div class="desk-play" data-desk-play><ContentDeck /></div>
</header>
<style>
	.desk-intro { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); align-items: center; gap: clamp(28px, 5vw, 70px); padding: 56px 7px; }
	.desk-owner { min-width: 0; }
	.desk-play { min-width: 0; width: 100%; max-width: 406px; justify-self: end; }
	.owner-label { display: inline-flex; align-items: center; gap: 12px; min-height: 44px; text-decoration: none; color: var(--ink-2); font-size: 12px; }
	.owner-label img { width: 40px; height: 40px; border-radius: var(--avatar-radius); }
	h1 { font: 400 clamp(96px, 8.5vw, 128px)/.9 var(--serif-en); margin: 28px 0 21px; letter-spacing: -.035em; }
	h1 span { color: var(--accent); }
	.desk-lead { font: 400 clamp(25px, 2.5vw, 32px)/1.5 var(--serif-zh); margin: 0 0 14px; letter-spacing: -.025em; text-wrap: pretty; }
	.desk-description { font-size: 14px; line-height: 1.85; color: var(--ink-2); margin: 0; }
	.desk-start { display: inline-flex; gap: 14px; align-items: center; min-height: 44px; margin-top: 21px; color: var(--ink-2); text-decoration: none; font-size: 12px; }
	.desk-start span { transition: transform var(--motion-ui) var(--decel); }
	.desk-start:hover { color: var(--accent); }
	.desk-start:hover span { transform: translateY(3px); }
	a:focus-visible { outline: 2px solid var(--accent); outline-offset: 5px; }
	@media (max-width: 1000px) { .desk-intro { gap: 28px; } }
	@media (max-width: 700px) {
		.desk-intro { grid-template-columns: minmax(0, 1fr); gap: 28px; padding: 28px 0 42px; }
		h1 { font-size: clamp(76px, 22vw, 100px); margin: 14px 0; }
		.desk-lead { font-size: clamp(22px, 5.6vw, 28px); margin-bottom: 7px; }
		.desk-description { font-size: 13px; line-height: 1.8; }
		.desk-start { margin-top: 7px; }
		.desk-play { max-width: none; padding-inline: 7px; }
	}
	@media (prefers-reduced-motion: reduce) { .desk-start span { transition: none; } .desk-start:hover span { transform: none; } }
</style>
