---
import { profile } from '../../data/profile';
import ContentDeck from './ContentDeck.astro';
---
<header class="desk-intro" id="hello">
	<div class="desk-owner">
		<a class="owner-label" href="/about/"><img src="/social/avatar-soft-square.png" alt="禾冉的头像" width="52" height="52" decoding="async" /><span>禾冉的个人网站 <small>NOTES, THINGS & A LITTLE PLAY</small></span></a>
		<h1>{profile.nameEn}<span>.</span></h1>
		<p class="desk-lead">写下来的，<br />和做出来的。</p>
		<p class="desk-description">我是禾冉。这里放 AI 使用笔记、日常观察，<br class="desktop-break" />还有自己做的小工具和视频。</p>
		<a class="desk-start" href="#writing">往下翻翻 <span aria-hidden="true">↓</span></a>
	</div>
	<div class="desk-play" data-desk-play><ContentDeck /></div>
</header>
<style>
	.desk-intro { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); align-items: center; gap: clamp(32px, 5vw, 76px); padding: 40px 8px 46px; }
	.desk-owner { min-width: 0; }
	.desk-play { min-width: 0; width: 100%; max-width: 440px; justify-self: end; }
	.owner-label { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; color: var(--ink-2); font-size: 12px; }
	.owner-label img { width: 52px; height: 52px; border-radius: var(--avatar-radius); }
	.owner-label small { display: block; font: 9px/1.7 var(--mono); letter-spacing: .07em; margin-top: 3px; }
	h1 { font: 400 clamp(72px, 8vw, 116px)/.95 var(--serif-en); margin: 22px 0 16px; letter-spacing: -.035em; }
	h1 span { color: var(--accent); }
	.desk-lead { font: 400 clamp(25px, 3vw, 35px)/1.5 var(--serif-zh); margin: 0 0 14px; }
	.desk-lead br { display: none; }
	.desk-description { font-size: 14px; line-height: 1.85; color: var(--ink-2); margin: 0; }
	.desk-start { display: inline-flex; gap: 26px; align-items: center; min-height: 44px; margin-top: 14px; color: var(--accent); text-decoration: none; font-size: 12px; }
	.desk-start span { transition: transform 350ms var(--spring); }
	.desk-start:hover span { transform: translateY(4px); }
	a:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
	@media (max-width: 700px) { .desk-intro { grid-template-columns: minmax(0, 1fr); gap: 24px; padding: 26px 4px 32px; } h1 { font-size: 80px; margin: 16px 0 12px; } .desk-lead { font-size: 26px; margin-bottom: 10px; } .desk-description { font-size: 13px; } .desk-start { margin-top: 8px; } .owner-label img { width: 44px; height: 44px; } }
	@media (max-width: 700px) { .desk-play { max-width: none; } }
	@media (max-width: 360px) { .desktop-break { display: none; } }
	@media (prefers-reduced-motion: no-preference) { h1 { animation: ink-arrives 600ms var(--decel); } @keyframes ink-arrives { from { transform: translateY(8px); } to { transform: none; } } }
	@media (prefers-reduced-motion: reduce) { .desk-start span { transition: none; } .desk-start:hover span { transform: none; } }
</style>
