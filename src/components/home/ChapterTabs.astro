<nav class="chapter-tabs" data-chapter-tabs aria-label="这一页的章节">
	<a href="#writing" aria-current="location"><span aria-hidden="true">01</span> 图文随记</a>
	<a href="#screening"><span aria-hidden="true">02</span> 视频放映</a>
	<a href="#making"><span aria-hidden="true">03</span> 做的小工具</a>
	<a href="#contact"><span aria-hidden="true">04</span> 找到我</a>
</nav>
<script>
	const nav = document.querySelector<HTMLElement>('[data-chapter-tabs]');
	if (nav) {
		const links = [...nav.querySelectorAll<HTMLAnchorElement>('a')];
		const sections = links.map((link) => document.getElementById(link.hash.slice(1)));
		let frame = 0;
		let requested: string | null = null;
		const mark = (active: number) => links.forEach((link, index) => { if (index === active) link.setAttribute('aria-current', 'location'); else link.removeAttribute('aria-current'); });
		const update = () => {
			frame = 0;
			let active = 0;
			sections.forEach((section, index) => { if (section && section.getBoundingClientRect().top <= 180) active = index; });
			// 页末不足一屏时锚点无法顶到顶部，仍保留点击的章节，不误标成上一节。
			if (requested) active = links.findIndex((link) => link.hash === requested);
			else if (scrollY + innerHeight >= document.documentElement.scrollHeight - 3) active = links.length - 1;
			mark(Math.max(0, active));
		};
		links.forEach((link, index) => link.addEventListener('click', () => { requested = link.hash; mark(index); }));
		const release = () => { requested = null; update(); };
		addEventListener('wheel', release, { passive: true });
		addEventListener('touchstart', release, { passive: true });
		addEventListener('keydown', (event) => { if (['ArrowDown', 'ArrowUp', 'PageDown', 'PageUp', 'Home', 'End', ' '].includes(event.key)) release(); });
		const schedule = () => { if (!frame) frame = requestAnimationFrame(update); };
		addEventListener('scroll', schedule, { passive: true });
		addEventListener('resize', schedule, { passive: true });
		update();
	}
</script>
<style>
	.chapter-tabs { position: sticky; top: var(--top); z-index: 9; display: flex; gap: 7px; align-items: end; padding-top: 7px; background: var(--paper); border-bottom: 1px solid var(--rule); margin-bottom: 28px; }
	.chapter-tabs a { position: relative; min-width: 0; display: inline-flex; justify-content: center; align-items: center; min-height: 44px; gap: 10px; color: var(--ink-2); text-decoration: none; font-size: 12px; padding: 10px 21px; border: 1px solid transparent; border-bottom: 0; border-radius: 5px 5px 0 0; background: var(--paper-3); transition: background var(--motion-fast) var(--decel), color var(--motion-fast) var(--decel); }
	.chapter-tabs a:hover { background: var(--paper-2); color: var(--accent); }
	.chapter-tabs span { font: 11px var(--mono); color: var(--ink-3); }
	.chapter-tabs a[aria-current] { color: var(--accent); background: var(--paper-2); border-color: var(--rule); }
	.chapter-tabs a[aria-current]::before { content: ''; position: absolute; top: -1px; left: 14px; width: 21px; height: 2px; background: var(--accent); }
	.chapter-tabs a[aria-current]::after { content: ''; position: absolute; bottom: -1px; left: 0; right: 0; height: 1px; background: var(--paper-2); }
	.chapter-tabs a[aria-current] span { color: var(--accent); }
	.chapter-tabs a:focus-visible { outline: 2px solid var(--accent); outline-offset: -3px; }
	@media (max-width: 700px) { .chapter-tabs a { flex: 1; gap: 4px; padding: 7px 2px; font-size: 11px; } .chapter-tabs span { font-size: 9px; } .chapter-tabs a[aria-current]::before { left: 7px; width: 14px; } }
	@media (max-width: 360px) { .chapter-tabs span { display: none; } }
	@media (prefers-reduced-motion: reduce) { .chapter-tabs a { transition: none; } }
</style>
