---
import type { LibraryItem } from '../../data/library';
import { platformLabels } from '../../data/library';
import { homeCover, homeTopic } from '../../lib/home';

interface Props {
	item: LibraryItem;
	variant?: 'lead' | 'support' | 'gallery' | 'snippet';
}
const { item, variant = 'gallery' } = Astro.props;
const cover = homeCover(item);
const href = `/content/${item.id}/`;
---

<article class:list={['entry', `entry--${variant}`, { 'entry--text': !cover }]} data-home-entry data-topic={homeTopic(item)}>
	{cover && (
		<a class="entry-image" href={href} tabindex="-1" aria-hidden="true">
			<img src={cover.src} alt="" width={cover.width} height={cover.height}
				loading={variant === 'lead' ? 'eager' : 'lazy'} fetchpriority={variant === 'lead' ? 'high' : 'auto'} decoding="async" />
		</a>
	)}
	<div class="entry-copy">
		<p class="entry-meta"><span>{platformLabels[item.platform]}</span>{item.publishedAt && <time datetime={item.publishedAt}>{item.publishedAt.replaceAll('-', '.')}</time>}</p>
		<h3><a href={href}>{item.title}</a></h3>
		<p class="entry-excerpt">{item.excerpt}</p>
		<a class="entry-read" href={href} aria-label={`站内阅读：${item.title}`}>读这篇 <span aria-hidden="true">↗</span></a>
	</div>
</article>

<style>
	.entry { min-width: 0; --photo-angle: -1.2deg; }
	.entry-image { display: block; overflow: hidden; padding: 7px; border: 1px solid var(--rule); border-radius: 1px; background: var(--paper-2); box-shadow: var(--shadow-paper); transform: rotate(var(--photo-angle)); transform-origin: center; transition: transform var(--motion-ui) var(--decel), box-shadow var(--motion-ui) var(--decel); }
	.entry-image img { width: 100%; height: auto; }
	.entry-copy { padding-top: 21px; }
	:global([data-scrapbook='aligned']) .entry-image { transform: none; box-shadow: none; }
	.entry-meta { display: flex; justify-content: space-between; gap: 8px 16px; flex-wrap: wrap; font-size: 11px; line-height: 1.6; color: var(--ink-2); margin: 0 0 9px; }
	.entry-meta time { font-family: var(--mono); white-space: nowrap; }
	h3 { font: 400 24px/1.4 var(--serif-zh); margin: 0; text-wrap: pretty; }
	h3 a { text-decoration: none; }
	.entry-excerpt { color: var(--ink-2); font-size: 14px; line-height: 1.75; margin: 10px 0 0; text-wrap: pretty; }
	.entry-read { display: inline-flex; gap: 20px; align-items: center; min-height: 44px; margin-top: 8px; font-size: 12px; color: var(--accent); text-decoration: none; }
	.entry--lead { grid-column: 1; grid-row: 1 / 3; }
	.entry--lead h3 { font-size: clamp(25px, 2.4vw, 32px); }
	.entry--lead .entry-excerpt { font-size: 15px; }
	.entry--lead .entry-image { padding: 7px; }
	.entry--lead .entry-image img { aspect-ratio: 16/11; object-fit: cover; }
	.entry--lead .entry-copy { padding-inline: 7px; }
	.entry--support { --photo-angle: 2deg; grid-column: 2; display: grid; grid-template-columns: minmax(112px, .8fr) minmax(0, 1.25fr); gap: 21px; align-items: start; padding: 7px 0 28px; border-bottom: 1px solid var(--rule); }
	.entry--support:nth-child(3) { --photo-angle: -2deg; }
	.entry--support .entry-copy { padding-top: 0; }
	.entry--support .entry-image img { height: 168px; object-fit: cover; }
	.entry--support .entry-excerpt { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; }
	.entry--support h3 { font-size: 21px; }
	.entry--support .entry-meta { display: block; }
	.entry--support time { display: block; margin-top: 3px; }
	.entry--support .entry-excerpt { font-size: 13px; }
	.entry--gallery { --photo-angle: 1.6deg; grid-column: 1; grid-row: 3 / 5; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 28px; padding-top: 42px; border-top: 1px solid var(--rule); align-items: center; }
	.entry--gallery .entry-copy { padding: 0; }
	.entry--gallery .entry-image img { max-height: 300px; object-fit: contain; }
	.entry--snippet { grid-column: 2; padding: 21px 0 7px; border-top: 1px solid var(--rule); }
	.entry--snippet .entry-copy { padding: 0; }
	.entry--snippet h3 { font-size: 23px; }
	.entry--snippet .entry-meta { color: var(--ink-2); }
	.entry a:focus-visible { outline: 2px solid var(--accent); outline-offset: 5px; border-radius: 3px; }
	.entry a:hover { color: var(--accent); }
	.entry h3 a:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 5px; }
	@media (hover: hover) and (pointer: fine) { .entry-image:hover { transform: translateY(-3px) rotate(0deg); box-shadow: var(--shadow-lift); } }
	@media (max-width: 1000px) {
		.entry--support { grid-template-columns: 112px minmax(0, 1fr); gap: 14px; }
		.entry--support .entry-image img { height: 150px; }
		.entry--support h3 { font-size: 19px; }
	}
	@media (max-width: 700px) {
		.entry--lead, .entry--support, .entry--gallery, .entry--snippet { grid-column: auto; grid-row: auto; }
		.entry--support { padding: 20px 0; }
		.entry--gallery { padding-top: 22px; gap: 18px; }
		.entry--gallery h3 { font-size: 21px; }
		.entry--snippet { padding-top: 6px; padding-bottom: 6px; }
	}
	@media (prefers-reduced-motion: reduce) { .entry-image { transition: none; } .entry-image:hover { transform: rotate(var(--photo-angle)); } :global([data-scrapbook='aligned']) .entry-image:hover { transform: none; } }
	/* 始终优先于图文条目的 grid 布局，包括响应式规则。 */
	.entry[hidden] { display: none !important; }
</style>
