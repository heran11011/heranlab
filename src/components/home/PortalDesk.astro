---
import { library } from '../../data/library';
import { profile } from '../../data/profile';

// 首页只负责选择去处，正文、图文目录和作品陈列都留在独立页面。
const pages = [
	{ id: 'content', label: '内容', title: '写下的，留在这里。', description: '图文、笔记和视频，收在同一册里。', note: `${library.length} 条公开内容`, href: '/content/', action: '翻开内容册' },
	{ id: 'work', label: '作品', title: '动手做的，放在这里。', description: '插件、Agent Skill，还有硬件小项目。', note: '工具与实验', href: '/work/', action: '看看做过的' },
	{ id: 'about', label: '关于', title: '再认识一下禾冉。', description: '一些介绍、做过的事，和公开账号。', note: '禾冉 / heran', href: '/about/', action: '读一下介绍' },
	{ id: 'contact', label: '联系', title: '有想聊的？', description: '写封邮件就好。', note: profile.email, href: '/about/#contact', action: '找到联系方式' },
];
---

<section class="portal-desk" data-portal-desk aria-label="翻纸签，选择要去的地方">
	<div class="portal-tabs" data-portal-tabs role="tablist" aria-label="选择纸签" hidden>
		{pages.map((page, index) => <button type="button" role="tab" id={`portal-tab-${page.id}`} data-portal-tab={index} aria-selected={String(index === 0)} aria-controls={`portal-page-${page.id}`} tabindex={index === 0 ? 0 : -1}>{page.label}</button>)}
	</div>
	<div class="portal-stack">
		<div class="portal-stage" data-portal-stage>
			{pages.map((page, index) => <article class="portal-sheet" id={`portal-page-${page.id}`} data-portal-sheet data-page-index={index} hidden={index !== 0} inert={index !== 0} tabindex="0" aria-label={`${page.label}纸签`}>
				<div class="portal-face">
					<div class="portal-paper-top"><span>{page.label}</span><span aria-hidden="true">{String(index + 1).padStart(2, '0')} / 04</span></div>
					<h2>{page.title}</h2>
					<p class="portal-description">{page.description}</p>
					<p class="portal-note">{page.note}</p>
					<a class="portal-open" href={page.href}>{page.action} <span aria-hidden="true">↗</span></a>
				</div>
			</article>)}
		</div>
	</div>
	<div class="portal-controls" data-portal-controls hidden>
		<button type="button" data-portal-prev aria-label="上一张纸签">←</button>
		<span class="portal-hint" data-portal-hint>左右拖动，随手翻翻。</span>
		<button type="button" class="portal-next" data-portal-next>翻一张 <span aria-hidden="true">→</span></button>
	</div>
	<p class="sr-only" data-portal-status role="status" aria-live="polite" aria-atomic="true">第 1 张，共 4 张：内容</p>
	<noscript><nav class="portal-fallback" aria-label="直接前往">{pages.map((page) => <a href={page.href}>{page.label} ↗</a>)}</nav></noscript>
</section>

<script>
	document.querySelectorAll<HTMLElement>('[data-portal-desk]').forEach((desk) => {
		const stage = desk.querySelector<HTMLElement>('[data-portal-stage]');
		const sheets = [...desk.querySelectorAll<HTMLElement>('[data-portal-sheet]')];
		const tabs = [...desk.querySelectorAll<HTMLButtonElement>('[data-portal-tab]')];
		const previous = desk.querySelector<HTMLButtonElement>('[data-portal-prev]');
		const next = desk.querySelector<HTMLButtonElement>('[data-portal-next]');
		const status = desk.querySelector<HTMLElement>('[data-portal-status]');
		if (!stage || !previous || !next || !status || !sheets.length) return;
		const reduce = matchMedia('(prefers-reduced-motion: reduce)');
		const fine = matchMedia('(hover: hover) and (pointer: fine)');
		let current = 0, requested = 0;
		let queued: number | null = null;
		let running = false;
		let animations: Animation[] = [];
		let rebound: Animation | null = null;
		const cancelRebound = () => { rebound?.cancel(); rebound = null; };
		let blockClickUntil = 0;
		type Drag = { id: number; x: number; y: number; dx: number; lastX: number; lastTime: number; velocity: number; active: boolean };
		let drag: Drag | null = null;
		const normalized = (index: number) => (index + sheets.length) % sheets.length;
		const resetLean = () => sheets.forEach((sheet) => { sheet.style.removeProperty('--lean-x'); sheet.style.removeProperty('--lean-y'); });
		const selectTabs = (index: number) => tabs.forEach((tab, number) => {
			tab.setAttribute('aria-selected', String(number === index));
			tab.tabIndex = number === index ? 0 : -1;
		});
		const settle = (index: number) => {
			current = index;
			sheets.forEach((sheet, number) => {
				sheet.hidden = number !== index;
				sheet.inert = number !== index;
				sheet.removeAttribute('aria-hidden');
				sheet.style.removeProperty('transform');
				sheet.classList.remove('is-leaving', 'is-arriving');
			});
			selectTabs(index);
			status.textContent = `第 ${index + 1} 张，共 ${sheets.length} 张：${tabs[index].textContent}`;
			stage.removeAttribute('aria-busy');
			desk.removeAttribute('data-turning');
			resetLean();
		};
		const flip = async (index: number) => {
			cancelRebound();
			if (index === current) { settle(index); return; }
			const outgoing = sheets[current], incoming = sheets[index];
			if (outgoing.contains(document.activeElement)) tabs[index].focus({ preventScroll: true });
			if (reduce.matches || typeof outgoing.animate !== 'function') { settle(index); return; }
			running = true;
			resetLean();
			incoming.hidden = false;
			incoming.inert = false;
			incoming.classList.add('is-arriving');
			outgoing.inert = true;
			outgoing.setAttribute('aria-hidden', 'true');
			outgoing.classList.add('is-leaving');
			stage.setAttribute('aria-busy', 'true');
			desk.setAttribute('data-turning', '');
			selectTabs(index);
			const initial = outgoing.style.transform || 'none';
			const lift = 'translateY(-32%) translateX(-5%) rotate(-4deg) scale(.97)';
			const duration = 620;
			animations = [
				outgoing.animate([
					{ transform: initial, zIndex: 3, offset: 0, easing: 'cubic-bezier(.22,.65,.3,1)' },
					{ transform: lift, zIndex: 3, offset: .43 },
					{ transform: lift, zIndex: 3, offset: .5 },
					{ transform: lift, zIndex: 0, offset: .51, easing: 'cubic-bezier(.16,1,.3,1)' },
					{ transform: 'translateY(9px) rotate(-2deg) scale(.98)', zIndex: 0, offset: 1 },
				], { duration, easing: 'linear', fill: 'both' }),
				incoming.animate([
					{ transform: 'translateY(7px) rotate(1deg) scale(.985)', offset: 0 },
					{ transform: 'translateY(7px) rotate(1deg) scale(.985)', offset: .38, easing: 'cubic-bezier(.16,1,.3,1)' },
					{ transform: 'none', offset: 1 },
				], { duration, easing: 'linear', fill: 'both' }),
			];
			await Promise.all(animations.map((animation) => animation.finished.catch(() => {})));
			settle(index);
			animations.forEach((animation) => animation.cancel());
			animations = [];
			running = false;
			const destination = queued;
			queued = null;
			if (destination !== null) void flip(destination);
		};
		const request = (index: number) => {
			requested = normalized(index);
			if (running) queued = requested;
			else void flip(requested);
		};
		tabs.forEach((tab, index) => {
			tab.addEventListener('click', () => request(index));
			tab.addEventListener('keydown', (event) => {
				if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
				event.preventDefault();
				const target = event.key === 'Home' ? 0 : event.key === 'End' ? sheets.length - 1 : normalized(index + (event.key === 'ArrowRight' ? 1 : -1));
				request(target);
				tabs[target].focus({ preventScroll: true });
			});
		});
		previous.addEventListener('click', () => request(requested - 1));
		next.addEventListener('click', () => request(requested + 1));
		stage.addEventListener('keydown', (event) => {
			if (event.target instanceof Element && event.target.closest('a, button')) return;
			if (!['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
			event.preventDefault();
			request(requested + (event.key === 'ArrowRight' ? 1 : -1));
		});
		stage.addEventListener('pointerdown', (event) => {
			if (running || (event.pointerType === 'mouse' && event.button !== 0) || !event.isPrimary) return;
			if (event.target instanceof Element && event.target.closest('a, button')) return;
			cancelRebound();
			drag = { id: event.pointerId, x: event.clientX, y: event.clientY, dx: 0, lastX: event.clientX, lastTime: performance.now(), velocity: 0, active: false };
		});
		stage.addEventListener('pointermove', (event) => {
			if (!drag) {
				if (running || reduce.matches || !fine.matches || event.pointerType !== 'mouse') return;
				const rect = sheets[current].getBoundingClientRect();
				sheets[current].style.setProperty('--lean-x', `${((event.clientX - rect.left) / rect.width - .5) * 4}px`);
				sheets[current].style.setProperty('--lean-y', `${((event.clientY - rect.top) / rect.height - .5) * 4 - 2}px`);
				return;
			}
			if (event.pointerId !== drag.id) return;
			const dx = event.clientX - drag.x, dy = event.clientY - drag.y;
			if (!drag.active) {
				if (Math.abs(dy) > 10 && Math.abs(dy) > Math.abs(dx)) { drag = null; return; }
				if (Math.abs(dx) < 8 || Math.abs(dx) <= Math.abs(dy) * 1.2) return;
				drag.active = true;
				stage.setPointerCapture(event.pointerId);
				desk.classList.add('is-dragging');
				resetLean();
			}
			const now = performance.now();
			drag.velocity = (event.clientX - drag.lastX) / Math.max(1, now - drag.lastTime);
			drag.lastX = event.clientX; drag.lastTime = now;
			drag.dx = Math.max(-160, Math.min(160, dx));
			if (!reduce.matches) sheets[current].style.transform = `translateX(${drag.dx}px) translateY(${-Math.min(16, Math.abs(drag.dx) * .12)}px) rotate(${drag.dx * .025}deg)`;
		});
		const finishDrag = (cancelled: boolean) => {
			const gesture = drag;
			drag = null;
			desk.classList.remove('is-dragging');
			if (!gesture) return;
			if (stage.hasPointerCapture(gesture.id)) stage.releasePointerCapture(gesture.id);
			if (!gesture.active) return;
			blockClickUntil = performance.now() + 200;
			const threshold = Math.min(72, sheets[current].getBoundingClientRect().width * .22);
			const recentVelocity = performance.now() - gesture.lastTime <= 120 ? gesture.velocity : 0;
			const commit = !cancelled && (Math.abs(gesture.dx) > threshold || (Math.abs(gesture.dx) > 30 && Math.abs(recentVelocity) > .45));
			if (commit) { request(requested + (gesture.dx < 0 ? 1 : -1)); return; }
			const sheet = sheets[current], initial = sheet.style.transform || 'none';
			sheet.style.removeProperty('transform');
			cancelRebound();
			if (!reduce.matches && typeof sheet.animate === 'function') {
				const spring = sheet.animate([{ transform: initial }, { transform: 'none' }], { duration: 180, easing: 'cubic-bezier(.16,1,.3,1)' });
				rebound = spring;
				void spring.finished.catch(() => {}).then(() => { if (rebound === spring) rebound = null; });
			}
		};
		stage.addEventListener('pointerup', (event) => { if (drag?.id === event.pointerId) finishDrag(false); });
		stage.addEventListener('pointercancel', (event) => { if (drag?.id === event.pointerId) finishDrag(true); });
		// 触屏先由子元素隐式捕获，再转给 stage；子元素冒泡的 lost 不是手势取消。
		stage.addEventListener('lostpointercapture', (event) => { if (event.target === stage && drag?.id === event.pointerId) finishDrag(true); });
		stage.addEventListener('pointerleave', () => { resetLean(); if (drag && !drag.active) drag = null; });
		stage.addEventListener('click', (event) => {
			if (performance.now() < blockClickUntil) { event.preventDefault(); event.stopPropagation(); }
		}, true);
		reduce.addEventListener('change', () => {
			if (reduce.matches) { finishDrag(true); cancelRebound(); resetLean(); animations.forEach((animation) => animation.cancel()); }
		});
		// JS 就绪后才出现切换控件；没有脚本时纸签和直达链接仍可用。
		sheets.forEach((sheet, index) => {
			sheet.setAttribute('role', 'tabpanel');
			sheet.setAttribute('aria-labelledby', tabs[index].id);
		});
		desk.querySelectorAll<HTMLElement>('[data-portal-tabs], [data-portal-controls]').forEach((element) => { element.hidden = false; });
		desk.dataset.ready = 'true';
	});
</script>

<style>
	.portal-desk { min-width: 0; width: 100%; max-width: 460px; justify-self: end; padding-inline: 7px; }
	.portal-tabs { display: flex; align-items: end; gap: 7px; padding: 0 7px 21px; }
	.portal-tabs button { min-height: 44px; min-width: 44px; padding: 7px 14px; color: var(--ink-2); background: transparent; border: 0; border-bottom: 1px solid transparent; font: 13px var(--sans); cursor: pointer; transition: color var(--motion-fast) var(--decel); }
	.portal-tabs button[aria-selected='true'] { color: var(--accent); border-bottom-color: var(--accent); }
	.portal-stack { position: relative; isolation: isolate; }
	.portal-stack::before, .portal-stack::after { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--paper-3); border: 1px solid var(--rule); transform: translateY(8px) rotate(-2deg); pointer-events: none; }
	.portal-stack::after { background: var(--paper-2); transform: translateY(4px) rotate(1.2deg); }
	.portal-stage { display: grid; position: relative; isolation: isolate; padding: 160px 16px 28px; margin: -160px -16px -28px; overflow: clip; pointer-events: none; }
	.portal-sheet { display: grid; min-width: 0; grid-area: 1/1; position: relative; pointer-events: auto; touch-action: pan-y; }
	.portal-sheet[hidden] { display: grid; visibility: hidden; pointer-events: none; }
	.portal-sheet[hidden] .portal-face { transition: none; }
	.portal-face { display: flex; flex-direction: column; min-height: 328px; padding: 28px 35px; background: var(--paper-2); border: 1px solid var(--rule); box-shadow: var(--shadow-paper); transform: translate(var(--lean-x, 0px), var(--lean-y, 0px)); transition: transform var(--motion-fast) var(--decel), box-shadow var(--motion-ui) var(--decel); }
	.portal-face::after { content: ''; position: absolute; right: 0; bottom: 0; width: 24px; height: 24px; background: linear-gradient(135deg, transparent 49%, var(--paper-3) 50%); pointer-events: none; }
	.portal-paper-top { display: flex; justify-content: space-between; gap: 14px; font: 11px/1.6 var(--mono); color: var(--ink-3); }
	.portal-paper-top span:first-child { color: var(--accent); }
	h2 { margin: 35px 0 14px; font: 400 clamp(26px, 2.2vw, 32px)/1.5 var(--serif-zh); letter-spacing: -.025em; overflow-wrap: anywhere; }
	.portal-description { margin: 0; font-size: 14px; line-height: 1.9; color: var(--ink-2); }
	.portal-note { margin: 14px 0 21px; font: 11px/1.8 var(--mono); color: var(--ink-3); overflow-wrap: anywhere; }
	.portal-open { display: inline-flex; align-items: center; justify-content: space-between; gap: 28px; align-self: flex-start; min-height: 44px; margin-top: auto; font-size: 13px; color: var(--accent); text-decoration: none; }
	.portal-open:hover { text-decoration: underline; text-underline-offset: 5px; }
	.portal-controls { display: flex; align-items: center; justify-content: space-between; gap: 7px; margin-top: 21px; }
	.portal-controls button { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; min-width: 44px; padding: 7px 12px; border: 1px solid var(--rule); background: transparent; color: var(--ink-2); font: 12px var(--sans); cursor: pointer; transition: background var(--motion-fast) var(--decel); }
	.portal-controls button:hover { background: var(--paper-3); color: var(--accent); }
	.portal-next { gap: 14px; }
	.portal-hint { color: var(--ink-3); font: 10px/1.6 var(--sans); text-align: center; }
	.portal-tabs[hidden], .portal-controls[hidden] { display: none; }
	.portal-fallback { display: flex; flex-wrap: wrap; gap: 14px; padding-top: 21px; }
	.portal-fallback a { display: inline-flex; align-items: center; min-height: 44px; color: var(--accent); font-size: 13px; }
	.is-leaving { z-index: 3; pointer-events: none; }
	.is-arriving { z-index: 2; }
	.is-leaving .portal-face, .is-dragging .portal-face { box-shadow: var(--shadow-lift); }
	.portal-desk[data-ready] .portal-sheet { cursor: grab; }
	.is-dragging .portal-sheet { cursor: grabbing; user-select: none; }
	.portal-sheet:focus-visible, :is(a, button):focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
	@media (max-width: 800px) {
		.portal-desk { justify-self: center; max-width: 460px; }
		.portal-face { min-height: 300px; padding: 21px 24px; }
		.portal-tabs { padding-bottom: 14px; }
		h2 { margin-top: 28px; font-size: 26px; }
		.portal-controls { margin-top: 21px; }
	}
	@media (max-width: 360px) { .portal-tabs { gap: 2px; } .portal-tabs button { padding-inline: 10px; } .portal-face { padding-inline: 21px; } .portal-hint { font-size: 9px; max-width: 92px; } }
	@media (prefers-reduced-motion: reduce) { .portal-face, .portal-tabs button, .portal-controls button { transition: none; } .portal-face { transform: none; } }
</style>
