---
import type { LibraryItem } from '../../data/library';
import { platformLabels } from '../../data/library';
import { homeCover } from '../../lib/home';
interface Props { items: readonly LibraryItem[]; }
const { items } = Astro.props;
---

<section class="screening" id="screening" aria-labelledby="screening-title" data-video-shelf>
	<header class="shelf-heading">
		<div><p class="shelf-kicker">换一种方式记录</p><h2 id="screening-title"><em aria-hidden="true">02</em> 放映架 <span>{items.length} 部视频</span></h2></div>
		<div class="shelf-controls" hidden>
			<button type="button" data-video-prev aria-label="向前翻视频" aria-controls="home-video-rail">←</button>
			<button type="button" data-video-next aria-label="向后翻视频" aria-controls="home-video-rail">→</button>
		</div>
	</header>
	<p class="shelf-intro">横着翻，挑一部。先读简介，再去原平台播放。</p>
	<div class="video-rail" id="home-video-rail" tabindex="0" role="region" aria-label="视频简介，可横向滚动">
		{items.map((item) => {
			const cover = homeCover(item);
			return (
				<article class:list={['video-entry', { 'video-entry--text': !cover }]}>
					{cover && <a class="video-image" href={`/content/${item.id}/`} tabindex="-1" aria-hidden="true">
						<img src={cover.src} alt="" width={cover.width} height={cover.height} loading="lazy" decoding="async" />
						<span class="play-mark">▶</span>
					</a>}
					<div class="video-copy">
						<p class="video-meta">{platformLabels[item.platform]} · {item.topic}{item.publishedAt && <time datetime={item.publishedAt}>{item.publishedAt.replaceAll('-', '.')}</time>}</p>
						{!cover && <span class="text-label">视频手记 / 简介</span>}
						<h3><a href={`/content/${item.id}/`}>{item.title}</a></h3>
						<p class="video-excerpt">{item.excerpt}</p>
						<div class="video-actions"><a href={`/content/${item.id}/`} aria-label={`站内简介：${item.title}`}>读简介 →</a><a href={item.sourceUrl} target="_blank" rel="noopener noreferrer" aria-label={`原视频：${item.title}（新窗口打开）`}>原视频 ↗</a></div>
					</div>
				</article>
			);
		})}
	</div>
</section>

<script>
	document.querySelectorAll<HTMLElement>('[data-video-shelf]').forEach((shelf) => {
		const rail = shelf.querySelector<HTMLElement>('.video-rail');
		const prev = shelf.querySelector<HTMLButtonElement>('[data-video-prev]');
		const next = shelf.querySelector<HTMLButtonElement>('[data-video-next]');
		const controls = shelf.querySelector<HTMLElement>('.shelf-controls');
		if (!rail || !prev || !next || !controls) return;
		controls.hidden = false;
		const reduce = matchMedia('(prefers-reduced-motion: reduce)');
		const update = () => {
			prev.disabled = rail.scrollLeft <= 2;
			next.disabled = rail.scrollLeft + rail.clientWidth >= rail.scrollWidth - 2;
		};
		const move = (direction: number) => {
			const card = rail.querySelector<HTMLElement>('.video-entry');
			const gap = parseFloat(getComputedStyle(rail).columnGap) || 0;
			rail.scrollBy({ left: direction * ((card?.getBoundingClientRect().width || rail.clientWidth) + gap), behavior: reduce.matches ? 'instant' : 'smooth' });
		};
		prev.addEventListener('click', () => move(-1));
		next.addEventListener('click', () => move(1));
		rail.addEventListener('scroll', update, { passive: true });
		rail.addEventListener('keydown', (event) => {
			if (event.target !== rail || !['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
			event.preventDefault();
			move(event.key === 'ArrowLeft' ? -1 : 1);
		});
		new ResizeObserver(update).observe(rail);
		update();
	});
</script>

<style>
	.screening { scroll-margin-top: 64px; margin-top: 62px; padding: 34px 0 40px; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
	.shelf-heading { display: flex; align-items: end; justify-content: space-between; gap: 18px; }
	.shelf-kicker { margin: 0 0 6px; color: var(--accent); font-size: 12px; }
	h2 { font: 400 30px/1.3 var(--serif-zh); margin: 0; }
	h2 em { font: 400 40px/.8 var(--serif-en); color: var(--accent); opacity: .65; margin-right: 14px; }
	h2 span { font: 12px var(--mono); color: var(--ink-2); margin-left: 14px; white-space: nowrap; }
	.shelf-intro { font-size: 14px; color: var(--ink-2); margin: 12px 0 20px; }
	.shelf-controls { display: flex; gap: 8px; }
	.shelf-controls[hidden] { display: none; }
	.shelf-controls button { width: 42px; height: 42px; border: 1px solid var(--rule); border-radius: 50%; background: var(--paper-2); color: var(--ink); font: 18px var(--sans); cursor: pointer; transition: background 180ms ease-out; }
	.shelf-controls button:hover:not(:disabled) { background: var(--accent); color: var(--paper); border-color: var(--accent); }
	.shelf-controls button:disabled { opacity: .4; cursor: default; }
	.video-rail { display: flex; gap: 22px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 6px 4px 22px; scrollbar-width: thin; scrollbar-color: var(--rule) transparent; }
	.video-entry { flex: 0 0 min(76%, 460px); min-width: 0; scroll-snap-align: start; scroll-margin-inline: 4px; display: flex; flex-direction: column; }
	.video-image { display: block; position: relative; overflow: hidden; background: var(--paper-2); border: 1px solid var(--rule); border-radius: 3px; }
	.video-image img { width: 100%; aspect-ratio: 16 / 9; height: auto; object-fit: contain; transition: transform 260ms cubic-bezier(0, 0, .2, 1); }
	.play-mark { position: absolute; bottom: 14px; left: 14px; width: 40px; height: 40px; display: grid; place-items: center; border-radius: 50%; background: var(--paper-2); color: var(--accent); font-size: 16px; padding-left: 2px; }
	.video-copy { padding: 16px 2px 0; display: flex; flex-direction: column; flex: 1; }
	.video-meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 12px; color: var(--ink-2); font-size: 11px; margin: 0 0 10px; }
	time { font-family: var(--mono); }
	h3 { font: 400 24px/1.4 var(--serif-zh); margin: 0; text-wrap: pretty; }
	h3 a { text-decoration: none; }
	.video-excerpt { font-size: 14px; color: var(--ink-2); margin: 10px 0 16px; }
	.video-actions { display: flex; gap: 22px; margin-top: auto; font-size: 13px; }
	.video-actions a { color: var(--accent); text-decoration: none; min-height: 38px; display: inline-flex; align-items: center; }
	.video-entry--text { border: 1px solid var(--rule); border-radius: 12px; background: var(--paper-2); padding: 26px; }
	.video-entry--text .video-copy { padding: 0; }
	.text-label { font: 12px var(--mono); color: var(--accent); margin: 40px 0 12px; }
	.video-entry--text h3 { font-size: 30px; }
	a:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 5px; }
	a:focus-visible, button:focus-visible, .video-rail:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
	@media (hover: hover) and (pointer: fine) { .video-image:hover img { transform: scale(1.02); } }
	@media (max-width: 700px) {
		.screening { margin-top: 40px; padding-top: 28px; }
		h2 span { display: block; margin: 8px 0 0; }
		.video-entry { flex-basis: 86%; }
		.video-entry--text { padding: 22px; }
		.video-entry--text h3 { font-size: 25px; }
		h3 { font-size: 21px; }
	}
	@media (prefers-reduced-motion: reduce) { .shelf-controls button, .video-image img { transition: none; } .video-image:hover img { transform: none; } .video-rail { scroll-behavior: auto; } }
</style>
