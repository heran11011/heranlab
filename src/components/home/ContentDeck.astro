---
import { library, platformLabels } from '../../data/library';
import { homeTopic } from '../../lib/home';
const items = [...library].sort((a, b) => Number(b.id === 'my-xiaohei-skill') - Number(a.id === 'my-xiaohei-skill'));
const topics = ['全部', 'AI 使用', '自己做的', '日常'];
---

<section class="paper-deck" data-paper-deck aria-labelledby="deck-title">
	<div class="deck-heading"><h2 id="deck-title">桌上随手一张</h2><span class="deck-counter" data-deck-count>01 / {String(items.length).padStart(2, '0')}</span></div>
	<div class="deck-topics" hidden role="group" aria-label="挑选纸签主题">
		{topics.map((topic) => <button type="button" data-deck-topic={topic} aria-pressed={topic === '全部' ? 'true' : 'false'} aria-controls="desk-papers">{topic}</button>)}
	</div>
	<div class="desk-papers" id="desk-papers">
		{items.map((item, index) => <article class="desk-paper" data-desk-paper data-topic={homeTopic(item)} hidden={index !== 0}>
			<p class="paper-source">{platformLabels[item.platform]} <span>· {item.topic}</span></p>
			<h3>{item.title}</h3>
			<p class="paper-excerpt">{item.excerpt}</p>
			<a href={`/content/${item.id}/`}>翻开{item.format === 'video' ? '这部视频的简介' : '这篇'} <span aria-hidden="true">↗</span></a>
		</article>)}
	</div>
	<div class="deck-bottom"><p data-deck-status role="status">从我的内容里，随手翻一张。</p><button type="button" class="deck-turn" data-deck-turn hidden>再翻一张 <span aria-hidden="true">↻</span></button></div>
</section>

<script>
	document.querySelectorAll<HTMLElement>('[data-paper-deck]').forEach((deck) => {
		const papers = [...deck.querySelectorAll<HTMLElement>('[data-desk-paper]')];
		const buttons = [...deck.querySelectorAll<HTMLButtonElement>('[data-deck-topic]')];
		const turn = deck.querySelector<HTMLButtonElement>('[data-deck-turn]');
		const counter = deck.querySelector<HTMLElement>('[data-deck-count]');
		const status = deck.querySelector<HTMLElement>('[data-deck-status]');
		const topics = deck.querySelector<HTMLElement>('.deck-topics');
		if (!turn || !counter || !status || !topics || !papers.length) return;
		let pool = papers, index = 0;
		const render = (announce: boolean) => {
			papers.forEach((paper) => { paper.hidden = paper !== pool[index]; });
			counter.textContent = `${String(index + 1).padStart(2, '0')} / ${String(pool.length).padStart(2, '0')}`;
			if (announce) status.textContent = `翻到了：${pool[index].querySelector('h3')?.textContent}`;
			turn.disabled = pool.length < 2;
		};
		buttons.forEach((button) => button.addEventListener('click', () => {
			pool = button.dataset.deckTopic === '全部' ? papers : papers.filter((paper) => paper.dataset.topic === button.dataset.deckTopic);
			index = 0;
			buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
			render(true);
		}));
		turn.addEventListener('click', () => { index = (index + 1) % pool.length; render(true); });
		topics.hidden = false; turn.hidden = false;
	});
</script>

<style>
	.paper-deck { min-width: 0; max-width: 440px; width: 100%; justify-self: end; }
	.deck-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 0 10px 12px; }
	.deck-heading h2 { font: 400 14px var(--sans); margin: 0; color: var(--ink-2); }
	.deck-counter { font: 11px var(--mono); color: var(--accent); }
	.deck-topics { display: flex; flex-wrap: wrap; gap: 2px; padding-bottom: 14px; }
	.deck-topics button { border: 0; background: transparent; color: var(--ink-2); font: 12px var(--sans); min-height: 44px; padding: 0 12px; cursor: pointer; border-radius: 24px; }
	.deck-topics button[aria-pressed='true'] { background: var(--paper-3); color: var(--ink); }
	.desk-papers { position: relative; isolation: isolate; }
	.desk-papers::before, .desk-papers::after { content: ''; position: absolute; z-index: -1; inset: 0; border: 1px solid var(--rule); border-radius: 3px; background: var(--paper-3); transform: rotate(-3deg); }
	.desk-papers::after { transform: rotate(2deg); background: var(--paper-2); }
	.desk-paper { min-height: 235px; padding: 26px 28px 20px; border: 1px solid var(--rule); border-radius: 3px; background: var(--paper-2); box-shadow: 0 12px 28px -22px color-mix(in srgb, var(--ink) 30%, transparent); }
	.desk-paper[hidden], .deck-topics[hidden], .deck-turn[hidden] { display: none; }
	.paper-source { color: var(--accent); font: 11px/1.6 var(--mono); margin: 0 0 16px; }
	.paper-source span { color: var(--ink-2); }
	h3 { margin: 0; font: 400 clamp(22px, 2.1vw, 28px)/1.45 var(--serif-zh); text-wrap: pretty; }
	.paper-excerpt { font-size: 13px; line-height: 1.8; color: var(--ink-2); margin: 12px 0 8px; }
	.desk-paper a { display: inline-flex; align-items: center; justify-content: space-between; gap: 20px; min-height: 44px; font-size: 12px; color: var(--accent); text-decoration: none; }
	.desk-paper a:hover { text-decoration: underline; text-underline-offset: 5px; }
	.deck-bottom { display: flex; gap: 12px; align-items: start; justify-content: space-between; margin-top: 18px; }
	.deck-bottom p { font-size: 11px; color: var(--ink-2); margin: 9px 0 0; max-width: 24em; }
	.deck-turn { flex: none; display: flex; align-items: center; gap: 10px; min-height: 44px; padding: 0 14px; border: 1px solid var(--rule); border-radius: 24px; background: var(--paper-2); color: var(--accent); font: 12px var(--sans); cursor: pointer; }
	.deck-turn span { display: inline-block; font-size: 18px; transition: transform 450ms var(--spring); }
	.deck-turn:hover span { transform: rotate(180deg); }
	:is(a, button):focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
	@media (hover: hover) and (pointer: fine) { .desk-paper { transition: transform 350ms var(--spring); } .desk-paper:hover { transform: translateY(-3px) rotate(-.5deg); } }
	@media (max-width: 700px) { .paper-deck { max-width: none; } .desk-paper { padding: 20px 22px 16px; min-height: 205px; } .deck-heading { padding-bottom: 6px; } .deck-topics { padding-bottom: 10px; } .deck-bottom { margin-top: 12px; } }
	@media (prefers-reduced-motion: no-preference) { .desk-paper:not([hidden]) { animation: paper-turn 380ms var(--spring); } @keyframes paper-turn { from { transform: translateY(6px) rotate(1.5deg); } to { transform: none; } } }
	@media (prefers-reduced-motion: reduce) { .desk-paper, .deck-turn span { transition: none; animation: none; } .desk-paper:hover, .deck-turn:hover span { transform: none; } }
</style>
