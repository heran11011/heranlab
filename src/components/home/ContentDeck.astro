---
import { library, platformLabels } from '../../data/library';
import { homeTopic } from '../../lib/home';
const items = [...library].sort((a, b) => Number(b.id === 'my-xiaohei-skill') - Number(a.id === 'my-xiaohei-skill'));
const topics = ['全部', 'AI 使用', '自己做的', '日常'];
---

<section class="paper-deck" data-paper-deck aria-labelledby="deck-title">
	<div class="deck-heading"><h2 id="deck-title">桌上随手一张</h2><span class="deck-counter" data-deck-count>01 / {String(items.length).padStart(2, '0')}</span></div>
	<div class="deck-topics" hidden role="group" aria-label="挑选纸签主题">
		{topics.map((topic) => <button type="button" data-deck-topic={topic} aria-pressed={topic === '全部' ? 'true' : 'false'} aria-controls="desk-papers">{topic}</button>)}
	</div>
	<div class="desk-papers" id="desk-papers">
		<div class="paper-stage" data-paper-stage>
			{items.map((item, index) => <article class="desk-paper" data-desk-paper data-topic={homeTopic(item)} hidden={index !== 0}>
				<div class="paper-front">
					<p class="paper-source">{platformLabels[item.platform]} <span>· {item.topic}</span></p>
					<h3>{item.title}</h3>
					<p class="paper-excerpt">{item.excerpt}</p>
					<a href={`/content/${item.id}/`}>翻开{item.format === 'video' ? '这部视频的简介' : '这篇'} <span aria-hidden="true">↗</span></a>
				</div>
			</article>)}
		</div>
	</div>
	<div class="deck-bottom"><p data-deck-status role="status">从我的内容里，随手翻一张。</p><button type="button" class="deck-turn" data-deck-turn hidden>再翻一张 <span aria-hidden="true">↻</span></button></div>
</section>

<script>
	document.querySelectorAll<HTMLElement>('[data-paper-deck]').forEach((deck) => {
		const papers = [...deck.querySelectorAll<HTMLElement>('[data-desk-paper]')];
		const buttons = [...deck.querySelectorAll<HTMLButtonElement>('[data-deck-topic]')];
		const turn = deck.querySelector<HTMLButtonElement>('[data-deck-turn]');
		const counter = deck.querySelector<HTMLElement>('[data-deck-count]');
		const status = deck.querySelector<HTMLElement>('[data-deck-status]');
		const topics = deck.querySelector<HTMLElement>('.deck-topics');
		const stage = deck.querySelector<HTMLElement>('[data-paper-stage]');
		if (!turn || !counter || !status || !topics || !stage || !papers.length) return;
		type Destination = { pool: HTMLElement[]; index: number; topic: string };
		const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
		let requested: Destination = { pool: papers, index: 0, topic: '全部' };
		let current = papers[0];
		let queued: Destination | undefined;
		let running = false;
		let animations: Animation[] = [];

		const settle = (destination: Destination) => {
			current = destination.pool[destination.index];
			papers.forEach((paper) => {
				paper.hidden = paper !== current;
				paper.inert = paper !== current;
				paper.removeAttribute('aria-hidden');
				paper.classList.remove('is-turning', 'is-arriving');
			});
			counter.textContent = `${String(destination.index + 1).padStart(2, '0')} / ${String(destination.pool.length).padStart(2, '0')}`;
			status.textContent = `翻到了：${current.querySelector('h3')?.textContent}`;
			status.title = status.textContent;
			buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.deckTopic === destination.topic)));
			turn.disabled = destination.pool.length < 2;
			stage.removeAttribute('aria-busy');
			deck.removeAttribute('data-turning');
			turn.removeAttribute('aria-busy');
		};

		const flip = async (destination: Destination) => {
			const incoming = destination.pool[destination.index];
			if (incoming === current || reducedMotion.matches || typeof current.animate !== 'function') {
				settle(destination);
				return;
			}
			running = true;
			const outgoing = current;
			const moveFocus = outgoing.contains(document.activeElement);
			// 把旧纸签抽起，再送到新纸签背后；同格堆叠始终保留完整内容的高度。
			incoming.hidden = false;
			incoming.inert = false;
			incoming.classList.add('is-arriving');
			outgoing.inert = true;
			outgoing.setAttribute('aria-hidden', 'true');
			outgoing.classList.add('is-turning');
			stage.setAttribute('aria-busy', 'true');
			deck.setAttribute('data-turning', '');
			turn.setAttribute('aria-busy', 'true');
			// 若从纸签内触发切换，焦点不能留在即将隐藏的旧纸上。
			if (moveFocus) turn.focus({ preventScroll: true });
			const duration = parseFloat(getComputedStyle(deck).getPropertyValue('--motion-paper')) || 680;
			const lifted = 'translateY(-38%) rotate(-4deg) scale(.96)';
			animations = [
				outgoing.animate([
					{ transform: 'none', zIndex: 3, offset: 0, easing: 'cubic-bezier(.22, .65, .3, 1)' },
					{ transform: lifted, zIndex: 3, offset: 0.43 },
					{ transform: lifted, zIndex: 3, offset: 0.5 },
					// 抽到最高点才换到背面层级，不能靠透明度让纸“消失”。
					{ transform: lifted, zIndex: 0, offset: 0.51, easing: 'cubic-bezier(.25, .65, .25, 1)' },
					{ transform: 'translateY(5px) rotate(-3deg) scale(.985)', zIndex: 0, offset: 1 },
				], { duration, easing: 'linear', fill: 'both' }),
				incoming.animate([
					{ transform: 'translateY(4px) rotate(1deg) scale(.985)', offset: 0 },
					{ transform: 'translateY(4px) rotate(1deg) scale(.985)', offset: 0.4, easing: 'cubic-bezier(.16, 1, .3, 1)' },
					{ transform: 'none', offset: 1 },
				], { duration, easing: 'linear', fill: 'both' }),
				outgoing.querySelector<HTMLElement>('.paper-front')!.animate([
					{ boxShadow: 'var(--paper-rest-shadow)', offset: 0 },
					{ boxShadow: 'var(--paper-lift-shadow)', offset: 0.35 },
					{ boxShadow: 'var(--paper-lift-shadow)', offset: 0.5 },
					{ boxShadow: 'none', offset: 0.65 },
					{ boxShadow: 'none', offset: 1 },
				], { duration, easing: 'linear', fill: 'both' }),
			];
			await Promise.all(animations.map((animation) => animation.finished.catch(() => {})));
			settle(destination);
			animations.forEach((animation) => animation.cancel());
			animations = [];
			running = false;
			// 连点只保留最后一个目标，不叠加多层翻页动画。
			const next = queued;
			queued = undefined;
			if (next) void flip(next);
		};

		const request = (destination: Destination) => {
			if (!destination.pool.length) return;
			requested = destination;
			if (running) queued = destination;
			else void flip(destination);
		};
		buttons.forEach((button) => button.addEventListener('click', () => {
			const topic = button.dataset.deckTopic || '全部';
			request({ pool: topic === '全部' ? papers : papers.filter((paper) => paper.dataset.topic === topic), index: 0, topic });
		}));
		turn.addEventListener('click', () => request({ ...requested, index: (requested.index + 1) % requested.pool.length }));
		reducedMotion.addEventListener('change', () => {
			if (reducedMotion.matches) animations.forEach((animation) => animation.cancel());
		});
		papers.forEach((paper) => { paper.inert = paper.hidden; });
		topics.hidden = false;
		turn.hidden = false;
	});
</script>

<style>
	.paper-deck { min-width: 0; max-width: 440px; width: 100%; justify-self: end; }
	.deck-heading { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 0 7px 14px; }
	.deck-heading h2 { font: 400 18px var(--serif-zh); margin: 0; color: var(--ink); }
	.deck-counter { font: 13px var(--mono); color: var(--accent); }
	.deck-topics { display: flex; flex-wrap: wrap; gap: 2px; padding-bottom: 14px; }
	.deck-topics button { border: 0; border-bottom: 1px solid transparent; background: transparent; color: var(--ink-2); font: 11px var(--sans); min-height: 44px; padding: 0 12px; cursor: pointer; border-radius: 0; }
	.deck-topics button[aria-pressed='true'] { color: var(--accent); border-bottom-color: var(--accent); }
	/* 同格堆叠：隐藏纸签仍参与尺寸计算，翻页和切换主题不会改变整叠高度。 */
	.desk-papers { display: grid; position: relative; isolation: isolate; }
	.desk-papers::before, .desk-papers::after { content: ''; position: absolute; z-index: -1; inset: 0; border: 1px solid var(--rule); border-radius: 3px; background: var(--paper-3); transform: rotate(-3deg); }
	.desk-papers::after { transform: rotate(2deg); background: var(--paper-2); }
	/* 给抽出的纸留绘制空间，但用负边距抵消：占位高度不变，手机也不横向溢出。 */
	.paper-stage { display: grid; position: relative; isolation: isolate; padding: 200px 12px 20px; margin: -200px -12px -20px; overflow: clip; pointer-events: none; }
	.desk-paper { display: grid; grid-area: 1 / 1; position: relative; min-width: 0; transform-origin: center; pointer-events: auto; }
	.paper-front { --paper-rest-shadow: var(--shadow-paper); --paper-lift-shadow: var(--shadow-lift); grid-area: 1 / 1; position: relative; display: flex; flex-direction: column; min-width: 0; min-height: 250px; padding: 28px 28px 21px; border: 1px solid var(--rule); border-radius: 1px; background: var(--paper-2); box-shadow: var(--paper-rest-shadow); }
	.paper-front::after { content: ''; position: absolute; right: 0; bottom: 0; width: 20px; height: 20px; background: linear-gradient(135deg, transparent 49%, var(--paper-3) 50%); pointer-events: none; }
	.is-turning { z-index: 3; pointer-events: none; will-change: transform; }
	.is-arriving { z-index: 2; will-change: transform; }
	.desk-paper[hidden] { display: grid; visibility: hidden; pointer-events: none; }
	.deck-topics[hidden], .deck-turn[hidden] { display: none; }
	.paper-source { color: var(--accent); font: 11px/1.6 var(--mono); margin: 0 0 16px; }
	.paper-source span { color: var(--ink-2); }
	h3 { margin: 0; font: 400 clamp(22px, 1.8vw, 26px)/1.45 var(--serif-zh); text-wrap: pretty; overflow-wrap: anywhere; }
	.paper-excerpt { font-size: 13px; line-height: 1.8; color: var(--ink-2); margin: 12px 0 8px; }
	.desk-paper a { display: inline-flex; align-items: center; align-self: flex-start; justify-content: space-between; gap: 20px; min-height: 44px; margin-top: auto; font-size: 12px; color: var(--accent); text-decoration: none; }
	.desk-paper a:hover { text-decoration: underline; text-underline-offset: 5px; }
	.deck-bottom { display: flex; gap: 12px; align-items: center; justify-content: space-between; min-height: 44px; margin-top: 18px; }
	.deck-bottom p { flex: 1; min-width: 0; font-size: 11px; line-height: 1.6; color: var(--ink-2); margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
	.deck-turn { flex: none; display: flex; align-items: center; gap: 14px; min-height: 44px; padding: 0 14px; border: 1px solid var(--accent); border-radius: 2px; background: var(--paper-2); color: var(--accent); font: 12px var(--sans); cursor: pointer; transition: background var(--motion-fast) var(--decel); }
	.deck-turn:hover { background: var(--paper-3); }
	.deck-turn span { display: inline-block; font-size: 18px; transition: transform 450ms var(--spring); }
	.deck-turn:hover span { transform: rotate(180deg); }
	:is(a, button):focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
	.deck-turn[aria-busy='true'] span { transform: rotate(360deg); transition-duration: var(--motion-paper); }
	@media (hover: hover) and (pointer: fine) { .paper-deck:not([data-turning]) .desk-paper:hover .paper-front { border-color: color-mix(in srgb, var(--accent) 45%, var(--rule)); } }
	@media (max-width: 700px) { .paper-deck { max-width: none; } .paper-front { padding: 20px 22px 16px; min-height: 205px; } .deck-heading { padding-bottom: 6px; } .deck-topics { padding-bottom: 10px; } .deck-bottom { margin-top: 12px; } }
	@media (prefers-reduced-motion: reduce) { .deck-turn span { transition: none; } .deck-turn:hover span, .deck-turn[aria-busy='true'] span { transform: none; } }
</style>
